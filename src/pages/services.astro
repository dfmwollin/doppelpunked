---
import BaseLayout from "../layouts/BaseLayout.astro";
---
<BaseLayout
  title="Angebot — :Doppelpunked"
  description="Unterstützung bei KI-Einführung, technischem Marketing, Training und Kommunikation."
>
  <section class="page-hero">
    <div class="container">
      <p class="eyebrow">Angebot</p>
      <h1>Verstehen. Strukturieren. Umsetzen.</h1>
      <p class="lead">
        Meine Angebote eignen sich für Unternehmen, Bildungseinrichtungen,
        Teams und Organisationen, die technische oder digitale Themen
        verständlicher und wirksamer machen möchten.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container grid">
      <article class="card">
        <h2>KI & Workflows</h2>
        <ul class="list">
          <li>Einführung in ChatGPT, Claude und NotebookLM</li>
          <li>Entwicklung sinnvoller Arbeitsabläufe</li>
          <li>Prompting, Wissensmanagement und Dokumentation</li>
          <li>Praxisnahe Team-Schulungen</li>
        </ul>
      </article>

      <article class="card">
        <h2>Produkt & Marketing</h2>
        <ul class="list">
          <li>Positionierung und Nutzenargumentation</li>
          <li>Go-to-Market-Unterstützung</li>
          <li>Vertriebsunterlagen und Webtexte</li>
          <li>Technische Inhalte für nichttechnische Zielgruppen</li>
        </ul>
      </article>

      <article class="card">
        <h2>Training & Bildung</h2>
        <ul class="list">
          <li>Workshops und Schulungskonzepte</li>
          <li>KI für Lehrer, Teams und Organisationen</li>
          <li>Technik- und Projektunterricht</li>
          <li>Deutsch, Englisch oder zweisprachig</li>
        </ul>
      </article>

      <article class="card">
        <h2>Kommunikation & Präsentation</h2>
        <ul class="list">
          <li>Präsentationskonzepte und Storytelling</li>
          <li>Infografiken und erklärende Visualisierungen</li>
          <li>Technische Dokumentation</li>
          <li>Strukturierung komplexer Informationen</li>
        </ul>
      </article>
    </div>
  </section>
</BaseLayout>
