---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  titleDe="Angebot — :Doppelpunked"
  titleEn="Services — :Doppelpunked"
  descriptionDe="Unterstützung für Unternehmen, Bildungseinrichtungen, Teams und Einzelpersonen in den Bereichen KI, Kommunikation, Coaching, Bildung und technisches Marketing."
  descriptionEn="Support for companies, educational institutions, teams and individuals in AI, communication, coaching, education and technical marketing."
>
  <section class="page-hero">
    <div class="page-hero-inner">
      <p
        class="eyebrow"
        data-de="Angebot"
        data-en="Services"
      >
        Angebot
      </p>

      <h1
        data-de="Verstehen. Strukturieren. Umsetzen."
        data-en="Understand. Structure. Deliver."
      >
        Verstehen. Strukturieren. Umsetzen.
      </h1>

      <p
        class="lead"
        data-de="Meine Angebote richten sich an Unternehmen, Bildungseinrichtungen, Teams und Einzelpersonen, die technische, digitale oder kommunikative Themen klarer, professioneller und wirksamer gestalten möchten."
        data-en="My services are for companies, educational institutions, teams and individuals who want to make technical, digital or communication-related topics clearer, more professional and more effective."
      >
        Meine Angebote richten sich an Unternehmen, Bildungseinrichtungen,
        Teams und Einzelpersonen, die technische, digitale oder kommunikative
        Themen klarer, professioneller und wirksamer gestalten möchten.
      </p>
    </div>
  </section>

  <section class="content-section">
    <div class="content-inner cards">
      <article class="focus-card reveal">
        <div class="card-top">
          <span class="number">01</span>
          <span class="card-icon" aria-hidden="true">✦</span>
        </div>

        <h3
          data-de="KI & Workflows"
          data-en="AI & Workflows"
        >
          KI & Workflows
        </h3>

        <p
          data-de="KI-Werkzeuge sinnvoll einsetzen, Arbeitsabläufe verbessern und individuelle oder teambezogene Unterstützung bei der praktischen Anwendung bieten."
          data-en="Using AI tools effectively, improving workflows and providing practical support for individuals or teams."
        >
          KI-Werkzeuge sinnvoll einsetzen, Arbeitsabläufe verbessern und
          individuelle oder teambezogene Unterstützung bei der praktischen
          Anwendung bieten.
        </p>

        <ul>
          <li
            data-de="Einführung in moderne KI-Werkzeuge"
            data-en="Introduction to modern AI tools"
          >
            Einführung in moderne KI-Werkzeuge
          </li>

          <li
            data-de="Workflow-Optimierung"
            data-en="Workflow improvement"
          >
            Workflow-Optimierung
          </li>

          <li
            data-de="Prompting und Recherche"
            data-en="Prompting and research"
          >
            Prompting und Recherche
          </li>

          <li
            data-de="Individuelle und teambezogene Unterstützung"
            data-en="Individual and team support"
          >
            Individuelle und teambezogene Unterstützung
          </li>
        </ul>
      </article>

      <article class="focus-card reveal">
        <div class="card-top">
          <span class="number">02</span>
          <span class="card-icon" aria-hidden="true">↗</span>
        </div>

        <h3
          data-de="Produkt, Marketing & Gestaltung"
          data-en="Product, Marketing & Design"
        >
          Produkt, Marketing & Gestaltung
        </h3>

        <p
          data-de="Produkte und Ideen klar positionieren, ihren Nutzen verständlich kommunizieren und visuell überzeugend präsentieren."
          data-en="Positioning products and ideas clearly, communicating their value and presenting them visually in a convincing way."
        >
          Produkte und Ideen klar positionieren, ihren Nutzen verständlich
          kommunizieren und visuell überzeugend präsentieren.
        </p>

        <ul>
          <li
            data-de="Positionierung und Nutzenargumentation"
            data-en="Positioning and value propositions"
          >
            Positionierung und Nutzenargumentation
          </li>

          <li
            data-de="Go-to-Market und Produkteinführung"
            data-en="Go-to-market and product launches"
          >
            Go-to-Market und Produkteinführung
          </li>

          <li
            data-de="Präsentationen und Vertriebsunterlagen"
            data-en="Presentations and sales materials"
          >
            Präsentationen und Vertriebsunterlagen
          </li>

          <li
            data-de="Logo- und Gestaltungsideen"
            data-en="Logo and design concepts"
          >
            Logo- und Gestaltungsideen
          </li>
        </ul>
      </article>

      <article class="focus-card reveal">
        <div class="card-top">
          <span class="number">03</span>
          <span class="card-icon" aria-hidden="true">◎</span>
        </div>

        <h3
          data-de="Training, Sprachen & Coaching"
          data-en="Training, Languages & Coaching"
        >
          Training, Sprachen & Coaching
        </h3>

        <p
          data-de="Workshops und individuelles Coaching für Präsentationen, Englisch, Deutsch, Lernen und professionelle Kommunikation."
          data-en="Workshops and individual coaching for presentations, English, German, learning and professional communication."
        >
          Workshops und individuelles Coaching für Präsentationen, Englisch,
          Deutsch, Lernen und professionelle Kommunikation.
        </p>

        <ul>
          <li
            data-de="Präsentationscoaching"
            data-en="Presentation coaching"
          >
            Präsentationscoaching
          </li>

          <li
            data-de="Englisch und Deutsch"
            data-en="English and German"
          >
            Englisch und Deutsch
          </li>

          <li
            data-de="Workshops und Schulungskonzepte"
            data-en="Workshops and training concepts"
          >
            Workshops und Schulungskonzepte
          </li>

          <li
            data-de="Individuelle Lern- und Kommunikationsunterstützung"
            data-en="Individual learning and communication support"
          >
            Individuelle Lern- und Kommunikationsunterstützung
          </li>
        </ul>
      </article>

      <article class="focus-card reveal">
        <div class="card-top">
          <span class="number">04</span>
          <span class="card-icon brand-icon" aria-hidden="true">:</span>
        </div>

        <h3
          data-de="Kommunikation & Präsentation"
          data-en="Communication & Presentation"
        >
          Kommunikation & Präsentation
        </h3>

        <p
          data-de="Texte prüfen und verbessern, komplexe Inhalte verständlich machen und Präsentationen, Dokumentationen oder Infografiken klar strukturieren."
          data-en="Proofreading and improving texts, making complex topics understandable, and structuring presentations, documentation and infographics clearly."
        >
          Texte prüfen und verbessern, komplexe Inhalte verständlich machen
          und Präsentationen, Dokumentationen oder Infografiken klar strukturieren.
        </p>

        <ul>
          <li
            data-de="Korrekturlesen und Textoptimierung"
            data-en="Proofreading and text improvement"
          >
            Korrekturlesen und Textoptimierung
          </li>

          <li
            data-de="Präsentationen und Storytelling"
            data-en="Presentations and storytelling"
          >
            Präsentationen und Storytelling
          </li>

          <li
            data-de="Technische Dokumentation"
            data-en="Technical documentation"
          >
            Technische Dokumentation
          </li>

          <li
            data-de="Infografiken und verständliche Visualisierung"
            data-en="Infographics and clear visualization"
          >
            Infografiken und verständliche Visualisierung
          </li>
        </ul>
      </article>
    </div>
  </section>

  <section class="contact-section">
    <div class="contact-inner reveal">
      <p
        class="section-label"
        data-de="Zusammenarbeit"
        data-en="Collaboration"
      >
        Zusammenarbeit
      </p>

      <h2
        data-de="Du hast ein Thema, bei dem ein klarer Blick von außen helfen könnte?"
        data-en="Do you have a topic where a clear outside perspective could help?"
      >
        Du hast ein Thema, bei dem ein klarer Blick von außen helfen könnte?
      </h2>

      <a
        class="button button-primary"
        href="/contact"
        data-de="Kontakt aufnehmen"
        data-en="Get in touch"
      >
        Kontakt aufnehmen
      </a>
    </div>
  </section>
</BaseLayout>