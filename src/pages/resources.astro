---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  titleDe="Ressourcen — :Doppelpunked"
  titleEn="Resources — :Doppelpunked"
  descriptionDe="Praktische Ressourcen zu KI, technischer Kommunikation, Bildung und Produktmarketing."
  descriptionEn="Practical resources on AI, technical communication, education and product marketing."
>
  <section class="page-hero">
    <div class="page-hero-inner">
      <p
        class="eyebrow"
        data-de="Ressourcen"
        data-en="Resources"
      >
        Ressourcen
      </p>

      <h1
        data-de="Hilfreiche Werkzeuge, Vorlagen und Erklärungen."
        data-en="Useful tools, templates and explanations."
      >
        Hilfreiche Werkzeuge, Vorlagen und Erklärungen.
      </h1>

      <p
        class="lead"
        data-de="Praxisnahe Inhalte für Menschen und Teams, die KI, Technik und Kommunikation sinnvoller einsetzen möchten."
        data-en="Practical resources for people and teams who want to use AI, technology and communication more effectively."
      >
        Praxisnahe Inhalte für Menschen und Teams, die KI, Technik und
        Kommunikation sinnvoller einsetzen möchten.
      </p>
    </div>
  </section>

  <section class="content-section">
    <div class="content-inner cards">
      <article class="focus-card reveal">
        <div class="card-top">
          <span class="number">01</span>
          <span class="card-icon" aria-hidden="true">✦</span>
        </div>

        <h3
          data-de="KI für den Arbeitsalltag"
          data-en="AI for everyday work"
        >
          KI für den Arbeitsalltag
        </h3>

        <p
          data-de="Praktische Ansätze für Recherche, Schreiben, Strukturierung, Wissensmanagement und wiederkehrende Aufgaben mit modernen KI-Werkzeugen."
          data-en="Practical approaches for research, writing, structuring, knowledge management and recurring tasks using modern AI tools."
        >
          Praktische Ansätze für Recherche, Schreiben, Strukturierung,
          Wissensmanagement und wiederkehrende Aufgaben mit modernen KI-Werkzeugen.
        </p>
      </article>

      <article class="focus-card reveal">
        <div class="card-top">
          <span class="number">02</span>
          <span class="card-icon" aria-hidden="true">◎</span>
        </div>

        <h3
          data-de="KI für Lehrer und Bildung"
          data-en="AI for teachers and education"
        >
          KI für Lehrer und Bildung
        </h3>

        <p
          data-de="Ideen und Hilfsmittel für Unterrichtsvorbereitung, Differenzierung, Lernmaterialien und den reflektierten Einsatz von KI im Bildungsbereich."
          data-en="Ideas and tools for lesson preparation, differentiation, learning materials and thoughtful use of AI in education."
        >
          Ideen und Hilfsmittel für Unterrichtsvorbereitung, Differenzierung,
          Lernmaterialien und den reflektierten Einsatz von KI im Bildungsbereich.
        </p>
      </article>

      <article class="focus-card reveal">
        <div class="card-top">
          <span class="number">03</span>
          <span class="card-icon" aria-hidden="true">↗</span>
        </div>

        <h3
          data-de="Technische Kommunikation"
          data-en="Technical communication"
        >
          Technische Kommunikation
        </h3>

        <p
          data-de="Methoden, um komplexe Inhalte zu strukturieren, Nutzen klar zu formulieren und technische Informationen verständlich zu präsentieren."
          data-en="Methods for structuring complex topics, communicating value clearly and presenting technical information in an understandable way."
        >
          Methoden, um komplexe Inhalte zu strukturieren, Nutzen klar zu
          formulieren und technische Informationen verständlich zu präsentieren.
        </p>
      </article>

      <article class="focus-card reveal">
        <div class="card-top">
          <span class="number">04</span>
          <span class="card-icon brand-icon" aria-hidden="true">:</span>
        </div>

        <h3
          data-de="Werkzeuge & Vorlagen"
          data-en="Tools & templates"
        >
          Werkzeuge & Vorlagen
        </h3>

        <p
          data-de="Checklisten, Vorlagen und kleine digitale Werkzeuge, die helfen, Ideen schneller zu strukturieren und direkt in die Praxis umzusetzen."
          data-en="Checklists, templates and small digital tools that help structure ideas faster and turn them into practical results."
        >
          Checklisten, Vorlagen und kleine digitale Werkzeuge, die helfen,
          Ideen schneller zu strukturieren und direkt in die Praxis umzusetzen.
        </p>
      </article>
    </div>
  </section>
</BaseLayout>