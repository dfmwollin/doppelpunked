---
import BaseLayout from "../layouts/BaseLayout.astro";
---
<BaseLayout
  title="Ressourcen — :Doppelpunked"
  description="Praktische Ressourcen zu KI, technischer Kommunikation, Bildung und Produktmarketing."
>
  <section class="page-hero">
    <div class="container">
      <p class="eyebrow">Ressourcen</p>
      <h1>Hilfreiche Werkzeuge, Vorlagen und Erklärungen.</h1>
      <p class="lead">
        Dieser Bereich kann später Suchmaschinen-Traffic aufbauen und zugleich
        zeigen, wie du denkst, erklärst und praktische Lösungen entwickelst.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container grid">
      <article class="card">
        <h2>KI für den Arbeitsalltag</h2>
        <p>Geplante Inhalte: Prompt-Vorlagen, Recherche-Workflows und sichere Einführung im Team.</p>
      </article>

      <article class="card">
        <h2>KI für Lehrer</h2>
        <p>Geplante Inhalte: Unterrichtsvorbereitung, Differenzierung, Arbeitsblätter und Reflexion.</p>
      </article>

      <article class="card">
        <h2>Technische Kommunikation</h2>
        <p>Geplante Inhalte: Nutzenargumentation, Präsentationsstruktur und verständliche Dokumentation.</p>
      </article>

      <article class="card">
        <h2>Werkzeuge & Vorlagen</h2>
        <p>Geplante Inhalte: Checklisten, Downloads, kleine HTML-Tools und Canva-Vorlagen.</p>
      </article>
    </div>
  </section>
</BaseLayout>
