---
// Standalone Astro page: src/pages/cv.astro
// The PDFs are served from public/cv/ and are reachable at /cv/<filename>.
const documents = [
  {
    code: 'DE',
    language: 'Deutsch',
    title: 'Lebenslauf',
    subtitle: 'Technisches B2B-Marketing · Produktkommunikation · Vertriebsunterstützung',
    description: 'Berufserfahrung, Projekte, technische Kompetenzen und Qualifikationen im Überblick.',
    href: '/cv/Master_Lebenslauf_DE_David_Wollin.pdf',
    downloadName: 'David_Wollin_Lebenslauf_DE.pdf',
    viewLabel: 'PDF ansehen',
    downloadLabel: 'Herunterladen',
  },
  {
    code: 'EN',
    language: 'English',
    title: 'Curriculum Vitae',
    subtitle: 'Technical B2B Marketing · Product Communications · Sales Support',
    description: 'An overview of professional experience, projects, technical skills and qualifications.',
    href: '/cv/Master_CV_EN_David_Wollin.pdf',
    downloadName: 'David_Wollin_CV_EN.pdf',
    viewLabel: 'View PDF',
    downloadLabel: 'Download',
  },
];
---
<!doctype html>
<html lang="de">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#f7f7f3" />
    <title>Lebenslauf / CV – David Wollin | :Doppelpunked</title>
    <meta name="description" content="Lebenslauf und CV von David Wollin als PDF: Technisches B2B-Marketing, Produktkommunikation, Engineering und Vertriebsunterstützung. Deutsch und Englisch." />
    <link rel="canonical" href="https://doppelpunked.com/cv/" />
  </head>
  <body>
    <div class="site-shell">
      <header class="site-header">
        <a class="brand" href="/" aria-label=":Doppelpunked – Startseite"><span class="brand-mark">:</span>Doppelpunked</a>
        <nav class="main-nav" aria-label="Hauptnavigation">
          <a href="/">Start</a>
          <a href="/about/">Über mich</a>
          <a href="/projects/">Projekte</a>
          <a href="/contact/">Kontakt</a>
        </nav>
      </header>

      <main id="main-content">
        <section class="hero" aria-labelledby="page-title">
          <div class="eyebrow"><span class="eyebrow-line"></span> PROFIL · PROFILE</div>
          <h1 id="page-title">Technik verstehen.<br /><em>Klar kommunizieren.</em></h1>
          <p class="intro">David F. M. Wollin verbindet Ingenieurwissen, Gestaltung und technische Kommunikation mit Erfahrung im B2B-Marketing, in der Produktkommunikation und in der Wissensvermittlung.</p>
          <p class="intro intro-en" lang="en">Engineering meets design, technical communication and customer-focused B2B marketing.</p>
        </section>

        <section class="documents" aria-labelledby="documents-title">
          <div class="section-header">
            <div>
              <p class="section-kicker">DOKUMENTE · DOCUMENTS</p>
              <h2 id="documents-title">Lebenslauf / CV</h2>
            </div>
            <p class="section-aside">Zwei Sprachen.<br />Ein Profil.</p>
          </div>
          <div class="document-grid">
            {documents.map((doc, index) => (
              <article class="document-card" lang={doc.code === 'DE' ? 'de' : 'en'}>
                <div class="document-topline">
                  <span class="document-index">0{index + 1} / PDF</span>
                  <span class="language-tag">{doc.code}</span>
                </div>
                <div class="document-content">
                  <p class="document-language">{doc.language}</p>
                  <h3>{doc.title}</h3>
                  <p class="document-subtitle">{doc.subtitle}</p>
                  <p class="document-description">{doc.description}</p>
                </div>
                <div class="document-actions">
                  <a class="primary-link" href={doc.href} target="_blank" rel="noopener noreferrer" aria-label={`${doc.viewLabel}: ${doc.title} (${doc.language})`}>
                    {doc.viewLabel}<span aria-hidden="true">↗</span>
                  </a>
                  <a class="secondary-link" href={doc.href} download={doc.downloadName} aria-label={`${doc.downloadLabel}: ${doc.title} (${doc.language})`}>
                    {doc.downloadLabel}<span aria-hidden="true">↓</span>
                  </a>
                </div>
              </article>
            ))}
          </div>
          <p class="documents-note">Beide Dokumente sind im PDF-Format verfügbar. / Both documents are available as PDFs.</p>
        </section>

        <section class="contact-strip" aria-labelledby="contact-title">
          <div>
            <p class="section-kicker">KONTAKT · CONTACT</p>
            <h2 id="contact-title">Lassen Sie uns ins Gespräch kommen.</h2>
            <p>Für berufliche Möglichkeiten, Projekte oder einen fachlichen Austausch.</p>
          </div>
          <div class="contact-actions">
            <a href="mailto:david@doppelpunked.com">E-Mail schreiben <span aria-hidden="true">↗</span></a>
            <a href="https://www.linkedin.com/in/dfmwollin" target="_blank" rel="noopener noreferrer">LinkedIn <span aria-hidden="true">↗</span></a>
          </div>
        </section>
      </main>

      <footer class="site-footer">
        <span>© {new Date().getFullYear()} David Wollin · <a href="/">:Doppelpunked</a></span>
        <div><a href="/impressum/">Impressum</a><a href="/datenschutz/">Datenschutz</a></div>
      </footer>
    </div>
  </body>
</html>

<style>
  :global(*) { box-sizing: border-box; }
  :global(html) { scroll-behavior: smooth; }
  :global(body) { margin: 0; background: #f7f7f3; color: #252a29; font-family: Inter, 'Segoe UI', system-ui, -apple-system, sans-serif; -webkit-font-smoothing: antialiased; }
  :global(a) { color: inherit; }
  :global(a:focus-visible) { outline: 3px solid #2b6f61; outline-offset: 4px; border-radius: 3px; }
  .site-shell { max-width: 1260px; min-height: 100vh; margin: auto; padding: 0 clamp(20px, 5vw, 72px); }
  .site-header { display: flex; justify-content: space-between; align-items: center; gap: 24px; min-height: 98px; border-bottom: 1px solid #dce0d8; }
  .brand { text-decoration: none; font-size: 1.32rem; font-weight: 800; letter-spacing: -0.065em; white-space: nowrap; }
  .brand-mark { color: #438776; font-weight: 900; }
  .main-nav { display: flex; flex-wrap: wrap; gap: clamp(12px, 2.3vw, 32px); align-items: center; }
  .main-nav a { text-decoration: none; color: #53615b; font-size: .875rem; font-weight: 600; }
  .main-nav a:hover, .site-footer a:hover { color: #216b5d; }
  .hero { padding: clamp(66px, 9vw, 128px) 0 clamp(56px, 7vw, 98px); max-width: 900px; }
  .eyebrow, .section-kicker, .document-index { color: #4e756a; font-size: .7rem; letter-spacing: .16em; font-weight: 800; }
  .eyebrow { display: flex; gap: 12px; align-items: center; }
  .eyebrow-line { display: inline-block; width: 28px; height: 1px; background: #4e756a; }
  h1 { font-size: clamp(2.7rem, 6.2vw, 5.8rem); line-height: 1.05; letter-spacing: -.065em; font-weight: 680; margin: 26px 0 27px; }
  h1 em { font-style: normal; color: #417c6d; }
  .intro { max-width: 730px; font-size: clamp(1.04rem, 1.5vw, 1.26rem); line-height: 1.7; color: #525e58; margin: 0; }
  .intro-en { margin-top: 12px; color: #7c8681; font-size: clamp(.95rem, 1.25vw, 1.06rem); }
  .documents { border-top: 1px solid #cfd8d0; padding: 50px 0 94px; }
  .section-header { display: flex; align-items: end; justify-content: space-between; gap: 20px; margin-bottom: 34px; }
  .section-kicker { margin: 0 0 13px; }
  h2 { font-size: clamp(1.6rem, 3vw, 2.25rem); margin: 0; font-weight: 650; letter-spacing: -.045em; }
  .section-aside { color: #8c9690; font-size: .87rem; text-align: right; line-height: 1.5; margin: 0; }
  .document-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 20px; }
  .document-card { border: 1px solid #d9dfd8; background: #fff; border-radius: 15px; min-height: 405px; padding: clamp(24px, 3vw, 38px); display: flex; flex-direction: column; transition: border-color .15s, transform .15s; }
  .document-card:hover { border-color: #6c9c8e; transform: translateY(-2px); }
  .document-topline { display: flex; justify-content: space-between; align-items: center; }
  .document-index { font-size: .67rem; color: #92a09a; }
  .language-tag { background: #e9f2ed; color: #2f705e; display: inline-flex; padding: 7px 11px; font-size: .72rem; font-weight: 800; border-radius: 6px; letter-spacing: .07em; }
  .document-content { flex: 1; }
  .document-language { color: #6b7a71; font-size: .87rem; margin: 36px 0 8px; }
  .document-card h3 { margin: 0 0 13px; font-size: clamp(1.7rem, 2.6vw, 2.15rem); line-height: 1.15; letter-spacing: -.04em; }
  .document-subtitle { font-weight: 620; line-height: 1.55; color: #4b655a; font-size: .91rem; max-width: 340px; margin: 0 0 14px; }
  .document-description { color: #78857d; line-height: 1.6; font-size: .91rem; max-width: 370px; margin: 0 0 18px; }
  .document-actions { border-top: 1px solid #e6ebe7; padding-top: 22px; display: flex; flex-wrap: wrap; align-items: center; gap: 12px; }
  .document-actions a { display: inline-flex; align-items: center; justify-content: space-between; gap: 20px; text-decoration: none; font-size: .89rem; font-weight: 700; border-radius: 8px; padding: 13px 17px; }
  .primary-link { background: #2a715e; color: #fff; }
  .primary-link:hover { background: #225b4d; }
  .secondary-link { border: 1px solid #dce3dd; color: #4e6558; }
  .secondary-link:hover { background: #f2f7f3; }
  .documents-note { color: #7d8a82; font-size: .79rem; margin: 20px 0 0; }
  .contact-strip { border-top: 1px solid #cfd8d0; border-bottom: 1px solid #cfd8d0; padding: 54px 0; display: flex; gap: 28px; justify-content: space-between; align-items: center; }
  .contact-strip p:not(.section-kicker) { color: #728178; line-height: 1.5; margin: 12px 0 0; }
  .contact-actions { display: flex; gap: 12px; flex-wrap: wrap; }
  .contact-actions a { border-radius: 8px; border: 1px solid #cedbd3; padding: 12px 16px; text-decoration: none; font-weight: 650; white-space: nowrap; font-size: .87rem; }
  .contact-actions a:hover { background: #eaf2ec; }
  .site-footer { min-height: 97px; display: flex; justify-content: space-between; gap: 20px; align-items: center; font-size: .8rem; color: #839088; }
  .site-footer a { text-decoration: none; }
  .site-footer div { display: flex; gap: 22px; }
  @media (max-width: 760px) {
    .site-header { flex-direction: column; align-items: flex-start; justify-content: center; padding: 20px 0; gap: 16px; }
    .main-nav { gap: 18px; }
    .hero { padding-top: 65px; }
    .document-grid { grid-template-columns: 1fr; }
    .document-card { min-height: 360px; }
    .contact-strip { flex-direction: column; align-items: flex-start; }
    .site-footer { padding: 23px 0; align-items: flex-start; flex-direction: column; }
  }
  @media (prefers-reduced-motion: reduce) { .document-card { transition: none; } }
</style>
