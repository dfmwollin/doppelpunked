---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  titleDe="Projekte — :Doppelpunked"
  titleEn="Projects — :Doppelpunked"
  descriptionDe="Ausgewählte Projekte aus KI, Produktmarketing, Bildung und technischer Kommunikation."
  descriptionEn="Selected projects in AI, product marketing, education and technical communication."
>
  <section class="page-hero">
    <div class="page-hero-inner">
      <p
        class="eyebrow"
        data-de="Projekte"
        data-en="Projects"
      >
        Projekte
      </p>

      <h1
        data-de="Arbeit, die Dinge verständlicher und nützlicher macht."
        data-en="Work that makes things clearer and more useful."
      >
        Arbeit, die Dinge verständlicher und nützlicher macht.
      </h1>

      <p
        class="lead"
        data-de="Eine Auswahl an Projekten und Arbeitsfeldern, in denen Technik, Kommunikation, Bildung und KI zusammenkommen."
        data-en="A selection of projects and areas of work where technology, communication, education and AI come together."
      >
        Eine Auswahl an Projekten und Arbeitsfeldern, in denen Technik,
        Kommunikation, Bildung und KI zusammenkommen.
      </p>
    </div>
  </section>

  <section class="content-section">
    <div class="content-inner cards">
      <article class="focus-card reveal">
        <div class="card-top">
          <span class="number">01</span>
          <span class="card-icon" aria-hidden="true">✦</span>
        </div>

        <h3
          data-de="KI-gestützte Content-Workflows"
          data-en="AI-supported content workflows"
        >
          KI-gestützte Content-Workflows
        </h3>

        <p
          data-de="Entwicklung von Arbeitsabläufen, mit denen Recherche, Text, Strukturierung und Content-Erstellung effizienter und konsistenter werden."
          data-en="Developing workflows that make research, writing, structuring and content creation more efficient and consistent."
        >
          Entwicklung von Arbeitsabläufen, mit denen Recherche, Text,
          Strukturierung und Content-Erstellung effizienter und konsistenter
          werden.
        </p>
      </article>

      <article class="focus-card reveal">
        <div class="card-top">
          <span class="number">02</span>
          <span class="card-icon" aria-hidden="true">↗</span>
        </div>

        <h3
          data-de="Technische Produkte klar positionieren"
          data-en="Positioning technical products clearly"
        >
          Technische Produkte klar positionieren
        </h3>

        <p
          data-de="Komplexe Produkte so aufbereiten, dass Nutzen, Zielgruppe und zentrale Botschaft für Vertrieb und Kunden schnell verständlich werden."
          data-en="Presenting complex products so that value, target audience and key messages become clear to sales teams and customers."
        >
          Komplexe Produkte so aufbereiten, dass Nutzen, Zielgruppe und
          zentrale Botschaft für Vertrieb und Kunden schnell verständlich werden.
        </p>
      </article>

      <article class="focus-card reveal">
        <div class="card-top">
          <span class="number">03</span>
          <span class="card-icon" aria-hidden="true">◎</span>
        </div>

        <h3
          data-de="Technikunterricht mit Prototyping"
          data-en="Technology education with prototyping"
        >
          Technikunterricht mit Prototyping
        </h3>

        <p
          data-de="Praxisorientierte Lernprojekte mit digitalen Werkzeugen, Simulation, Elektronik und Prototyping, bei denen Lernen durch eigenes Ausprobieren entsteht."
          data-en="Hands-on learning projects using digital tools, simulation, electronics and prototyping, with a strong focus on learning by doing."
        >
          Praxisorientierte Lernprojekte mit digitalen Werkzeugen, Simulation,
          Elektronik und Prototyping, bei denen Lernen durch eigenes Ausprobieren
          entsteht.
        </p>
      </article>

      <article class="focus-card reveal">
        <div class="card-top">
          <span class="number">04</span>
          <span class="card-icon brand-icon" aria-hidden="true">:</span>
        </div>

        <h3
          data-de="Komplexe Inhalte visualisieren"
          data-en="Visualizing complex content"
        >
          Komplexe Inhalte visualisieren
        </h3>

        <p
          data-de="Präsentationen, Infografiken und Dokumentationen so strukturieren und gestalten, dass Inhalte schneller erfasst und besser erinnert werden."
          data-en="Structuring and designing presentations, infographics and documentation so that information is understood faster and remembered more easily."
        >
          Präsentationen, Infografiken und Dokumentationen so strukturieren und
          gestalten, dass Inhalte schneller erfasst und besser erinnert werden.
        </p>
      </article>
    </div>
  </section>
</BaseLayout>