    <script>
      const buttons = document.querySelectorAll("[data-open]");

      buttons.forEach((button) => {
        button.addEventListener("click", () => {
          const id = button.getAttribute("data-open");
          const target = document.getElementById(id);

          if (!target) return;

          target.open = true;

          target.scrollIntoView({
            behavior: "smooth",
            block: "start",
          });
        });
      });
    </script>

