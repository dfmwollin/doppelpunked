---
const signals = [
  {
    date: "24 Aug 2026",
    title: "Acquisition: ADLATUS Robotics",
    category: "Portfolio Expansion",
    summary:
      "NEURA acquired ADLATUS Robotics, adding hundreds of installed autonomous cleaning systems, navigation technology, and application know-how.",
    why:
      "More products and inherited application knowledge may increase the challenge of making technical expertise available across sales and service teams.",
    source:
      "https://neura-robotics.com/de/neura-ubernimmt-adlatus-robotics/",
  },
  {
    date: "13 Aug 2026",
    title: "Acquisition: Bosch Rexroth ACTIVE Shuttle",
    category: "Portfolio Expansion",
    summary:
      "NEURA is integrating Bosch Rexroth's ACTIVE Shuttle into its Physical AI ecosystem.",
    why:
      "Expanding the product portfolio may increase configuration complexity and application-specific questions during the sales process.",
    source:
      "https://neura-robotics.com/de/neura-robotics-ubernimmt-active-shuttle/",
  },
  {
    date: "22 Jul 2026",
    title: "Global Training Expansion",
    category: "Knowledge Scaling",
    summary:
      "NEURA expanded its Physical AI training network with a new NEURA Gym at RWTH Aachen.",
    why:
      "Scaling training suggests that distributing technical knowledge effectively is strategically important.",
    source: "https://neura-robotics.com/de/news/",
  },
  {
    date: "10 Jun 2026",
    title: "Major Growth Financing",
    category: "Growth",
    summary:
      "NEURA announced financing of up to $1.4 billion to accelerate its Physical AI platform.",
    why:
      "Rapid organizational and product scaling can create pressure to scale technical sales knowledge more efficiently.",
    source: "https://neura-robotics.com/news/",
  },
  {
    date: "21 Apr 2026",
    title: "Strategic AWS Partnership",
    category: "Ecosystem",
    summary:
      "NEURA and AWS announced a strategic partnership around the Neuraverse, robotics training, and international market expansion.",
    why:
      "More partners, markets, and deployments can increase the number of people who need access to accurate technical application knowledge.",
    source:
      "https://neura-robotics.com/de/neura-robotics-und-amazon-web-services-starten-strategische-partnerschaft/",
  },
];

const scoreBreakdown = [
  {
    label: "Technical product complexity",
    score: 19,
    max: 20,
    reason:
      "Robotics, software, integrations, and multiple application environments create substantial technical complexity.",
  },
  {
    label: "Application engineering dependency",
    score: 18,
    max: 20,
    reason:
      "Robotics deployments typically require application-specific technical expertise during evaluation, configuration, and implementation.",
  },
  {
    label: "International / partner sales",
    score: 17,
    max: 20,
    reason:
      "NEURA is expanding through partnerships, ecosystems, and international activity.",
  },
  {
    label: "Growth and change signals",
    score: 18,
    max: 20,
    reason:
      "Recent acquisitions, financing, partnerships, and training expansion indicate significant organizational change.",
  },
  {
    label: "Evidence of current pain",
    score: 9,
    max: 20,
    reason:
      "There are strong structural indicators, but no direct public evidence confirming an application-engineering bottleneck.",
  },
];

const totalScore = scoreBreakdown.reduce((sum, item) => sum + item.score, 0);
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />

    <meta
      name="viewport"
      content="width=device-width, initial-scale=1.0"
    />

    <meta
      name="description"
      content="A GTM experiment exploring whether public signals can identify potential Bardin opportunities in the German industrial market."
    />

    <meta name="robots" content="noindex, nofollow" />

    <title>Bardin × Germany — NEURA Robotics</title>

    <style>
      :root {
        --bg: #f5f6f3;
        --card: #ffffff;
        --text: #10110f;
        --muted: #666b62;
        --border: #dde2d8;

        --green: #b7ff2a;
        --green-soft: #efffd0;
        --green-dark: #4d6908;

        --dark: #10110f;
      }

      * {
        box-sizing: border-box;
      }

      html {
        scroll-behavior: smooth;
      }

      body {
        margin: 0;
        font-family:
          Inter,
          ui-sans-serif,
          system-ui,
          -apple-system,
          BlinkMacSystemFont,
          "Segoe UI",
          sans-serif;
        background: var(--bg);
        color: var(--text);
        line-height: 1.55;
      }

      a {
        color: inherit;
      }

      main {
        width: min(1050px, calc(100% - 28px));
        margin: 0 auto;
        padding: 32px 0 70px;
      }

      /* HERO */

      .hero {
        position: relative;
        overflow: hidden;
        padding: 34px;
        border-radius: 24px;
        background: var(--dark);
        color: white;
      }

      .hero::after {
        content: "";
        position: absolute;
        width: 260px;
        height: 260px;
        right: -100px;
        top: -100px;
        border-radius: 50%;
        background: var(--green);
        opacity: 0.15;
      }

      .hero-content {
        position: relative;
        z-index: 1;
        display: grid;
        grid-template-columns: minmax(0, 1fr) 150px;
        gap: 34px;
        align-items: center;
      }

      .hero-text {
        min-width: 0;
      }

      .eyebrow {
        display: inline-block;
        margin-bottom: 14px;
        padding: 6px 10px;
        border-radius: 999px;
        background: var(--green);
        color: var(--dark);
        font-size: 12px;
        font-weight: 800;
        text-transform: uppercase;
        letter-spacing: 0.06em;
      }

      h1 {
        margin: 0;
        font-size: clamp(2.3rem, 6vw, 4.4rem);
        line-height: 0.95;
        letter-spacing: -0.05em;
      }

      .company-name {
        display: block;
        margin-top: 10px;
        color: var(--green);
        font-size: clamp(1.25rem, 3vw, 2rem);
        font-weight: 700;
      }

      .hero-copy {
        max-width: 740px;
        margin: 18px 0 0;
        color: #d5d9d0;
      }

      .meta-row {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
        margin-top: 22px;
      }

      .meta-pill {
        padding: 7px 11px;
        border: 1px solid #30342e;
        border-radius: 999px;
        background: #181a17;
        font-size: 13px;
      }

      .logo-wrap {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 150px;
        height: 150px;
        padding: 18px;
        border-radius: 22px;
        background: white;
      }

      .company-logo {
        display: block;
        width: 100%;
        height: 100%;
        object-fit: contain;
      }

      /* DECISION STRIP */

      .decision-strip {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 1px;
        overflow: hidden;
        margin-top: 14px;
        border: 1px solid var(--border);
        border-radius: 18px;
        background: var(--border);
      }

      .decision-item {
        padding: 18px;
        background: var(--card);
      }

      .decision-label {
        color: var(--muted);
        font-size: 12px;
        text-transform: uppercase;
        letter-spacing: 0.05em;
      }

      .decision-value {
        display: block;
        margin-top: 4px;
        font-size: 1.45rem;
        font-weight: 800;
      }

      .decision-value.green {
        color: var(--green-dark);
      }

      /* MAIN CONCLUSION */

      .main-insight {
        margin-top: 18px;
        padding: 22px;
        border: 1px solid var(--border);
        border-left: 5px solid var(--green);
        border-radius: 16px;
        background: var(--card);
      }

      .main-insight strong {
        display: block;
        margin-bottom: 6px;
        font-size: 0.82rem;
        text-transform: uppercase;
        letter-spacing: 0.06em;
        color: var(--green-dark);
      }

      .main-insight p {
        margin: 0;
        font-size: 1.08rem;
      }

      /* QUICK NAV */

      .quick-nav {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
        margin-top: 18px;
      }

      .quick-nav button {
        appearance: none;
        border: 1px solid var(--border);
        border-radius: 999px;
        padding: 9px 13px;
        background: var(--card);
        color: var(--text);
        font: inherit;
        font-size: 13px;
        font-weight: 700;
        cursor: pointer;
      }

      .quick-nav button:hover {
        border-color: var(--green-dark);
        background: var(--green-soft);
      }

      .quick-nav button:focus-visible {
        outline: 3px solid var(--green);
        outline-offset: 2px;
      }

      /* MODULES */

      .modules {
        margin-top: 30px;
        display: grid;
        gap: 12px;
      }

      details.module {
        overflow: hidden;
        border: 1px solid var(--border);
        border-radius: 18px;
        background: var(--card);
      }

      details.module[open] {
        border-color: #c8d6ae;
      }

      summary {
        list-style: none;
        cursor: pointer;
      }

      summary::-webkit-details-marker {
        display: none;
      }

      .module-summary {
        display: grid;
        grid-template-columns: 46px 1fr auto;
        gap: 14px;
        align-items: center;
        padding: 18px 20px;
      }

      .module-number {
        display: grid;
        place-items: center;
        width: 40px;
        height: 40px;
        border-radius: 12px;
        background: var(--green-soft);
        color: var(--green-dark);
        font-size: 13px;
        font-weight: 900;
      }

      .module-title {
        min-width: 0;
      }

      .module-title strong {
        display: block;
        font-size: 1.02rem;
      }

      .module-title span {
        display: block;
        margin-top: 2px;
        color: var(--muted);
        font-size: 0.87rem;
      }

      .chevron {
        display: inline-block;
        color: var(--muted);
        font-size: 1.4rem;
        transition: transform 0.2s ease;
      }

      details[open] > summary .chevron {
        transform: rotate(45deg);
      }

      .module-content {
        padding: 0 20px 22px 80px;
      }

      /* WHY NOW */

      .pressure-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 12px;
      }

      .pressure-card {
        padding: 16px;
        border-top: 4px solid var(--green);
        border-radius: 14px;
        background: #f8faf5;
      }

      .pressure-card span {
        display: block;
        color: var(--muted);
        font-size: 12px;
      }

      .pressure-card strong {
        display: block;
        margin: 4px 0 7px;
        font-size: 1.25rem;
      }

      .pressure-card p {
        margin: 0;
        color: var(--muted);
        font-size: 0.88rem;
      }

      /* SIGNALS */

      .signals-list {
        display: grid;
        gap: 8px;
      }

      details.signal {
        border: 1px solid var(--border);
        border-radius: 13px;
        background: #fafbf9;
      }

      .signal-summary {
        display: grid;
        grid-template-columns: 95px 1fr auto;
        gap: 12px;
        align-items: center;
        padding: 13px 14px;
      }

      .signal-date {
        color: var(--muted);
        font-size: 12px;
      }

      .signal-title-wrap {
        min-width: 0;
      }

      .signal-title-wrap strong {
        display: block;
      }

      .signal-category {
        display: inline-block;
        margin-top: 4px;
        padding: 3px 7px;
        border-radius: 999px;
        background: var(--green-soft);
        color: var(--green-dark);
        font-size: 10px;
        font-weight: 800;
      }

      .signal-detail {
        padding: 0 14px 15px 121px;
      }

      .signal-detail p {
        margin: 0 0 12px;
      }

      .implication {
        padding: 12px;
        border-left: 3px solid var(--green);
        border-radius: 8px;
        background: white;
      }

      .source-link {
        display: inline-block;
        margin-top: 12px;
        color: var(--green-dark);
        font-size: 13px;
        font-weight: 800;
        text-decoration: none;
      }

      .source-link:hover {
        text-decoration: underline;
      }

      /* SCORE */

      .score-layout {
        display: grid;
        grid-template-columns: 210px 1fr;
        gap: 16px;
      }

      .score-box {
        padding: 22px;
        border-top: 5px solid var(--green);
        border-radius: 16px;
        background: var(--dark);
        color: white;
      }

      .score-number {
        color: var(--green);
        font-size: 3.3rem;
        font-weight: 900;
        line-height: 1;
      }

      .score-caption {
        margin-top: 6px;
        color: #cbd0c7;
        font-size: 13px;
      }

      .score-status {
        display: inline-block;
        margin-top: 14px;
        padding: 6px 9px;
        border-radius: 999px;
        background: var(--green);
        color: var(--dark);
        font-size: 12px;
        font-weight: 800;
      }

      .score-list {
        display: grid;
        gap: 8px;
      }

      .score-row {
        padding: 12px 14px;
        border: 1px solid var(--border);
        border-radius: 12px;
      }

      .score-row-top {
        display: flex;
        justify-content: space-between;
        gap: 12px;
      }

      .score-row-top strong {
        font-size: 0.92rem;
      }

      .score-value {
        color: var(--green-dark);
        font-weight: 800;
      }

      .score-reason {
        margin-top: 4px;
        color: var(--muted);
        font-size: 0.84rem;
      }

      /* HYPOTHESIS */

      .hypothesis-box {
        padding: 20px;
        border-left: 5px solid var(--green);
        border-radius: 14px;
        background: #f9fbf6;
      }

      .hypothesis-label {
        display: block;
        margin-bottom: 7px;
        color: var(--green-dark);
        font-size: 12px;
        font-weight: 900;
        text-transform: uppercase;
        letter-spacing: 0.06em;
      }

      /* ACTION */

      .question-box {
        padding: 22px;
        border-radius: 14px;
        background: var(--dark);
        color: white;
      }

      .question-box small {
        color: var(--green);
        font-weight: 800;
        text-transform: uppercase;
        letter-spacing: 0.05em;
      }

      .question-box blockquote {
        margin: 10px 0 0;
        font-size: 1.15rem;
        font-weight: 700;
      }

      .action-list {
        display: grid;
        gap: 8px;
        margin-top: 14px;
        padding: 0;
        list-style: none;
      }

      .action-list li {
        padding: 13px 14px;
        border: 1px solid var(--border);
        border-left: 4px solid var(--green);
        border-radius: 10px;
      }

      /* FOOTER */

      footer {
        margin-top: 34px;
        padding-top: 18px;
        border-top: 1px solid var(--border);
        color: var(--muted);
        font-size: 12px;
      }

      @media (max-width: 760px) {
        main {
          width: min(100% - 20px, 1050px);
          padding-top: 18px;
        }

        .hero {
          padding: 24px 20px;
        }

        .hero-content {
          grid-template-columns: 1fr;
        }

        .logo-wrap {
          width: 110px;
          height: 110px;
        }

        .decision-strip {
          grid-template-columns: repeat(2, 1fr);
        }

        .module-summary {
          grid-template-columns: 40px 1fr auto;
          padding: 15px;
        }

        .module-content {
          padding: 0 15px 18px;
        }

        .pressure-grid,
        .score-layout {
          grid-template-columns: 1fr;
        }

        .signal-summary {
          grid-template-columns: 1fr auto;
        }

        .signal-date {
          grid-column: 1 / 2;
        }

        .signal-title-wrap {
          grid-column: 1 / 2;
        }

        .signal-summary .chevron {
          grid-column: 2;
          grid-row: 1 / 3;
        }

        .signal-detail {
          padding: 0 14px 15px;
        }
      }
    </style>
  </head>

  <body>
    <main>

      <!-- HERO -->

      <header class="hero">
        <div class="hero-content">

          <div class="hero-text">
            <span class="eyebrow">Private GTM Experiment</span>

            <h1>
              Bardin × Germany
              <span class="company-name">NEURA Robotics</span>
            </h1>

            <p class="hero-copy">
              Can public market signals identify industrial companies where
              deployment complexity, technical knowledge bottlenecks, and engineering
              escalation create a strong opportunity for Bardin?
            </p>

            <div class="meta-row">
              <span class="meta-pill">Germany / DACH</span>
              <span class="meta-pill">Robotics / Physical AI</span>
              <span class="meta-pill">Reviewed 27 Aug 2026</span>
            </div>
          </div>

          <div class="logo-wrap">
            <img
              src="/bardin/neura-logo.jfif"
              alt="NEURA Robotics logo"
              class="company-logo"
            />
          </div>

        </div>
      </header>


      <!-- DECISION SUMMARY -->

      <section class="decision-strip" aria-label="Account summary">

        <div class="decision-item">
          <span class="decision-label">ICP fit</span>
          <strong class="decision-value green">{totalScore}/100</strong>
        </div>

        <div class="decision-item">
          <span class="decision-label">Growth</span>
          <strong class="decision-value">High</strong>
        </div>

        <div class="decision-item">
          <span class="decision-label">Complexity</span>
          <strong class="decision-value">High</strong>
        </div>

        <div class="decision-item">
          <span class="decision-label">GTM urgency</span>
          <strong class="decision-value">Med–High</strong>
        </div>

      </section>


      <!-- MAIN INSIGHT -->

      <section class="main-insight">
        <strong>Why this account stands out</strong>

        <p>
          NEURA is simultaneously expanding its product portfolio, partner ecosystem,
          and international footprint. That combination may increase pressure on how
          application-specific technical knowledge is distributed across commercial
          and technical teams.
        </p>
      </section>


      <!-- QUICK NAV -->

      <nav class="quick-nav" aria-label="Explore account">
        <button type="button" data-open="why-now">Why now?</button>
        <button type="button" data-open="signals">Signals</button>
        <button type="button" data-open="fit">ICP fit</button>
        <button type="button" data-open="hypothesis">Hypothesis</button>
        <button type="button" data-open="action">Action</button>
      </nav>


      <!-- EXPANDABLE MODULES -->

      <section class="modules">


        <!-- 01 WHY NOW -->

        <details class="module" id="why-now">

          <summary class="module-summary">

            <span class="module-number">01</span>

            <span class="module-title">
              <strong>Why is NEURA interesting now?</strong>
              <span>Growth, complexity, and timing</span>
            </span>

            <span class="chevron">+</span>

          </summary>

          <div class="module-content">

            <div class="pressure-grid">

              <div class="pressure-card">
                <span>Growth pressure</span>
                <strong>High</strong>
                <p>
                  Acquisitions, funding, partnerships, and international expansion
                  are happening simultaneously.
                </p>
              </div>

              <div class="pressure-card">
                <span>Knowledge complexity</span>
                <strong>High</strong>
                <p>
                  Multiple robot platforms, software layers, applications, and
                  newly integrated technologies increase the amount of expertise
                  that must be shared.
                </p>
              </div>

              <div class="pressure-card">
                <span>GTM urgency</span>
                <strong>Medium–High</strong>
                <p>
                  Rapid expansion increases the importance of enabling commercial
                  teams and partners without scaling expert headcount at the same rate.
                </p>
              </div>

            </div>

          </div>

        </details>


        <!-- 02 SIGNALS -->

        <details class="module" id="signals">

          <summary class="module-summary">

            <span class="module-number">02</span>

            <span class="module-title">
              <strong>What signals did the research find?</strong>
              <span>{signals.length} recent public signals</span>
            </span>

            <span class="chevron">+</span>

          </summary>

          <div class="module-content">

            <div class="signals-list">

              {
                signals.map((signal) => (
                  <details class="signal">

                    <summary class="signal-summary">

                      <span class="signal-date">
                        {signal.date}
                      </span>

                      <span class="signal-title-wrap">
                        <strong>{signal.title}</strong>

                        <span class="signal-category">
                          {signal.category}
                        </span>
                      </span>

                      <span class="chevron">+</span>

                    </summary>

                    <div class="signal-detail">

                      <p>{signal.summary}</p>

                      <div class="implication">
                        <strong>Possible GTM implication</strong><br />
                        {signal.why}
                      </div>

                      <a
                        class="source-link"
                        href={signal.source}
                        target="_blank"
                        rel="noopener noreferrer"
                      >
                        View original source ↗
                      </a>

                    </div>

                  </details>
                ))
              }

            </div>

          </div>

        </details>


        <!-- 03 ICP FIT -->

        <details class="module" id="fit">

          <summary class="module-summary">

            <span class="module-number">03</span>

            <span class="module-title">
              <strong>Why does NEURA fit Bardin's ICP?</strong>
              <span>{totalScore}/100 structural fit</span>
            </span>

            <span class="chevron">+</span>

          </summary>

          <div class="module-content">

            <div class="score-layout">

              <div class="score-box">
                <div class="score-number">{totalScore}</div>
                <div class="score-caption">out of 100</div>
                <span class="score-status">Strong potential fit</span>
              </div>

              <div class="score-list">

                {
                  scoreBreakdown.map((item) => (
                    <div class="score-row">

                      <div class="score-row-top">
                        <strong>{item.label}</strong>

                        <span class="score-value">
                          {item.score}/{item.max}
                        </span>
                      </div>

                      <div class="score-reason">
                        {item.reason}
                      </div>

                    </div>
                  ))
                }

              </div>

            </div>

            <p
              style="margin-top:14px;color:var(--muted);font-size:0.84rem;"
            >
              This score measures structural fit with Bardin's use case.
              It is not a probability that NEURA is experiencing confirmed pain.
            </p>

          </div>

        </details>


        <!-- 04 HYPOTHESIS -->

        <details class="module" id="hypothesis">

          <summary class="module-summary">

            <span class="module-number">04</span>

            <span class="module-title">
              <strong>What pain might exist?</strong>
              <span>Research-generated hypothesis to validate</span>
            </span>

            <span class="chevron">+</span>

          </summary>

          <div class="module-content">

            <div class="hypothesis-box">

              <span class="hypothesis-label">
                Hypothesis — not confirmed fact
              </span>

              NEURA's rapid portfolio, ecosystem, and international expansion may make
              it increasingly difficult to distribute application-specific technical
              knowledge across sales, partners, service teams, and newly integrated
              business units without repeatedly involving scarce technical experts.

            </div>

          </div>

        </details>


        <!-- 05 ACTION -->

        <details class="module" id="action">

          <summary class="module-summary">

            <span class="module-number">05</span>

            <span class="module-title">
              <strong>What should Bardin do next?</strong>
              <span>Validate the hypothesis before selling</span>
            </span>

            <span class="chevron">+</span>

          </summary>

          <div class="module-content">

            <div class="question-box">

              <small>Best discovery question</small>

              <blockquote>
                “When a new customer or partner needs to configure a robot for a
