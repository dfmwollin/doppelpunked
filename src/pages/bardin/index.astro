---
import { companies } from "../../data/bardinCompanies.js";

const totalSignals = companies.reduce(
  (sum, company) => sum + company.signals.length,
  0
);

const averageFit = Math.round(
  companies.reduce((sum, company) => sum + company.totalScore, 0) /
    companies.length
);
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />

    <meta
      name="viewport"
      content="width=device-width, initial-scale=1.0"
    />

    <meta name="robots" content="noindex, nofollow" />

    <meta
      name="description"
      content="Private Bardin Germany GTM opportunity radar."
    />

    <title>Bardin × Germany — Opportunity Radar</title>

    <style>
      :root {
        --bg: #f5f6f3;
        --card: #ffffff;
        --text: #10110f;
        --muted: #666b62;
        --border: #dde2d8;

        --green: #b7ff2a;
        --green-soft: #efffd0;
        --green-dark: #4d6908;

        --dark: #10110f;
      }

      * {
        box-sizing: border-box;
      }

      body {
        margin: 0;

        font-family:
          Inter,
          ui-sans-serif,
          system-ui,
          -apple-system,
          BlinkMacSystemFont,
          "Segoe UI",
          sans-serif;

        background: var(--bg);
        color: var(--text);
        line-height: 1.55;
      }

      a {
        color: inherit;
      }

      main {
        width: min(1100px, calc(100% - 28px));
        margin: 0 auto;
        padding: 22px 0 70px;
      }

      /* COMPANY SWITCHER */

      .switcher {
        display: flex;
        gap: 7px;
        flex-wrap: wrap;
        margin-bottom: 12px;
      }

      .switcher a {
        padding: 8px 11px;

        border: 1px solid var(--border);
        border-radius: 999px;

        background: var(--card);
        color: var(--text);

        text-decoration: none;

        font-size: 12px;
        font-weight: 750;

        transition:
          background 0.15s ease,
          border-color 0.15s ease;
      }

      .switcher a:hover {
        background: var(--green-soft);
        border-color: var(--green);
      }

      .switcher a.active {
        background: var(--green);
        border-color: var(--green);
        color: var(--dark);
      }

      /* HERO */

      .hero {
        position: relative;
        overflow: hidden;

        padding: 34px;

        border-radius: 24px;
        background: var(--dark);
        color: white;
      }

      .hero::after {
        content: "";

        position: absolute;

        width: 300px;
        height: 300px;

        top: -130px;
        right: -100px;

        border-radius: 50%;

        background: var(--green);
        opacity: 0.15;
      }

      .hero-content {
        position: relative;
        z-index: 1;

        display: grid;
        grid-template-columns: minmax(0, 1fr) 155px;

        gap: 40px;

        align-items: center;
      }

      .hero-text {
        min-width: 0;
      }

      .eyebrow {
        display: inline-block;

        padding: 6px 10px;

        border-radius: 999px;

        background: var(--green);
        color: var(--dark);

        font-size: 12px;
        font-weight: 850;

        text-transform: uppercase;
        letter-spacing: 0.045em;
      }

      h1 {
        margin: 15px 0 0;

        font-size: clamp(2.3rem, 6vw, 4.5rem);
        line-height: 1.02;
        letter-spacing: -0.025em;
      }

      .hero p {
        max-width: 720px;

        margin: 15px 0 0;

        color: #d5d9d0;
      }

      /* BARDIN LOGO */

      .bardin-logo-wrap {
        position: relative;
        z-index: 2;

        display: flex;
        align-items: center;
        justify-content: center;

        width: 155px;
        height: 155px;

        padding: 18px;

        border: 1px solid #34382e;
        border-radius: 24px;

        background: #080908;
      }

      .bardin-logo {
        display: block;

        width: 100%;
        height: 100%;

        object-fit: contain;
      }

      /* STATS */

      .stats {
        display: grid;
        grid-template-columns: repeat(4, 1fr);

        gap: 1px;

        margin-top: 14px;

        overflow: hidden;

        border: 1px solid var(--border);
        border-radius: 18px;

        background: var(--border);
      }

      .stat {
        padding: 18px;
        background: white;
      }

      .stat small {
        display: block;

        color: var(--muted);

        text-transform: uppercase;
        letter-spacing: 0.05em;
      }

      .stat strong {
        display: block;

        margin-top: 3px;

        font-size: 1.55rem;
      }

      .stat strong.green {
        color: var(--green-dark);
      }

      /* SECTIONS */

      section {
        margin-top: 34px;
      }

      .section-head {
        display: flex;
        align-items: end;
        justify-content: space-between;

        gap: 18px;

        margin-bottom: 14px;
      }

      h2 {
        margin: 0;

        font-size: 1.35rem;
        letter-spacing: -0.015em;
      }

      .section-head p {
        max-width: 580px;

        margin: 0;

        color: var(--muted);

        font-size: 0.88rem;
      }

      /* ACCOUNT CARDS */

      .account-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);

        gap: 12px;
      }

      .account-card {
        display: flex;
        flex-direction: column;

        min-width: 0;

        padding: 18px;

        border: 1px solid var(--border);
        border-radius: 17px;

        background: var(--card);
      }

      .account-top {
        display: flex;
        align-items: center;

        gap: 12px;
      }

      .mini-logo {
        width: 62px;
        height: 62px;

        display: grid;
        place-items: center;

        flex: 0 0 auto;

        padding: 8px;

        border: 1px solid var(--border);
        border-radius: 13px;

        background: #ffffff;

        font-weight: 850;
        font-size: 0.8rem;
      }

      .mini-logo img {
        width: 100%;
        height: 100%;

        object-fit: contain;
      }

      .account-name {
        min-width: 0;
      }

      .account-name strong {
        display: block;

        font-size: 1.08rem;
      }

      .account-name span {
        display: block;

        color: var(--muted);

        font-size: 0.78rem;
      }

      .fit-line {
        display: flex;
        align-items: end;
        justify-content: space-between;

        margin-top: 17px;
      }

      .fit-line span {
        color: var(--muted);

        font-size: 0.76rem;

        text-transform: uppercase;
        letter-spacing: 0.05em;
      }

      .fit-line strong {
        color: var(--green-dark);

        font-size: 1.65rem;
        line-height: 1;
      }

      .big-track,
      .metric-track {
        overflow: hidden;

        border-radius: 999px;

        background: #ecefe8;
      }

      .big-track {
        height: 8px;

        margin-top: 7px;
      }

      .metric-track {
        height: 5px;
      }

      .bar {
        height: 100%;

        border-radius: inherit;

        background: var(--green);
      }

      .reason {
        margin: 14px 0;

        color: var(--muted);

        font-size: 0.88rem;
      }

      .open-link {
        margin-top: auto;

        display: inline-flex;
        justify-content: center;

        padding: 9px 11px;

        border-radius: 10px;

        background: var(--dark);
        color: white;

        text-decoration: none;

        font-size: 0.84rem;
        font-weight: 750;
      }

      .open-link:hover {
        background: var(--green);
        color: var(--dark);
      }

      /* ICP COMPARISON */

      .comparison {
        padding: 20px;

        border: 1px solid var(--border);
        border-radius: 18px;

        background: white;
      }

      .compare-row {
        display: grid;
        grid-template-columns: 110px 1fr 48px;

        gap: 12px;

        align-items: center;
      }

      .compare-row + .compare-row {
        margin-top: 14px;
      }

      .compare-name {
        font-weight: 780;
        font-size: 0.9rem;
      }

      .compare-track {
        height: 18px;

        overflow: hidden;

        border-radius: 999px;

        background: #edf0ea;
      }

      .compare-fill {
        height: 100%;

        border-radius: inherit;

        background: var(--green);
      }

      .compare-score {
        text-align: right;

        font-weight: 850;

        color: var(--green-dark);
      }

      /* PROFILE GRAPHS */

      .profiles {
        display: grid;
        grid-template-columns: repeat(3, 1fr);

        gap: 12px;
      }

      .profile-card {
        padding: 18px;

        border: 1px solid var(--border);
        border-radius: 17px;

        background: white;
      }

      .profile-card h3 {
        margin: 0 0 14px;

        font-size: 1rem;
      }

      .metric + .metric {
        margin-top: 11px;
      }

      .metric-head {
        display: flex;
        justify-content: space-between;

        gap: 8px;

        margin-bottom: 4px;
      }

      .metric-head span {
        color: var(--muted);

        font-size: 0.74rem;
      }

      .metric-head strong {
        font-size: 0.76rem;

        color: var(--green-dark);
      }

      /* METHOD */

      .method {
        padding: 17px;

        border: 1px dashed #bdc7ae;
        border-radius: 14px;

        background: #fafcf7;

        color: var(--muted);

        font-size: 0.86rem;
      }

      .method strong {
        margin-right: 4px;
        color: var(--text);
      }

      /* FOOTER */

      footer {
        margin-top: 34px;

        padding-top: 18px;

        border-top: 1px solid var(--border);

        color: var(--muted);

        font-size: 12px;
      }

      /* MOBILE */

      @media (max-width: 780px) {
        main {
          width: min(100% - 20px, 1100px);
          padding-top: 14px;
        }

        .hero {
          padding: 24px 20px;
        }

        .hero-content {
          grid-template-columns: 1fr;
        }

        .bardin-logo-wrap {
          width: 105px;
          height: 105px;

          margin-top: 6px;
        }

        .stats {
          grid-template-columns: repeat(2, 1fr);
        }

        .account-grid,
        .profiles {
          grid-template-columns: 1fr;
        }

        .section-head {
          align-items: start;
          flex-direction: column;

          gap: 5px;
        }

        .compare-row {
          grid-template-columns: 74px 1fr 38px;

          gap: 8px;
        }
      }
    </style>
  </head>

  <body>
    <main>

      <!-- COMPANY SWITCHER -->

      <nav class="switcher" aria-label="Company switcher">

        <a
          href="/bardin"
          class="active"
          aria-current="page"
        >
          Overview
        </a>

        {
          companies.map((company) => (
            <a href={`/bardin/${company.slug}`}>
              {company.shortName}
            </a>
          ))
        }

      </nav>


      <!-- HERO -->

      <header class="hero">

        <div class="hero-content">

          <div class="hero-text">

            <span class="eyebrow">
              Private GTM Experiment
            </span>

            <h1>
              Bardin × Germany<br />
              Opportunity Radar
            </h1>

            <p>
              A small agent-assisted experiment: use public signals to prioritize
              German industrial accounts where application-engineering knowledge
              may be difficult to scale across sales, deployment, partners, and
              support.
            </p>

          </div>


          <div class="bardin-logo-wrap">

            <img
              src="/bardin/bardin_logo.jpeg"
              alt="Bardin logo"
              class="bardin-logo"
            />

          </div>

        </div>

      </header>


      <!-- SUMMARY -->

      <section class="stats" aria-label="Radar summary">

        <div class="stat">
          <small>Accounts</small>
          <strong>{companies.length}</strong>
        </div>

        <div class="stat">
          <small>Signals reviewed</small>
          <strong>{totalSignals}</strong>
        </div>

        <div class="stat">
          <small>Average ICP fit</small>
          <strong class="green">{averageFit}/100</strong>
        </div>

        <div class="stat">
          <small>Strong-fit accounts</small>
          <strong>
            {companies.filter((c) => c.totalScore >= 80).length}
          </strong>
        </div>

      </section>


      <!-- ACCOUNTS -->

      <section>

        <div class="section-head">

          <h2>
            Choose an account
          </h2>

          <p>
            Three deliberately different Bardin customer profiles:
            emerging robotics, global robotics deployment, and automation components.
          </p>

        </div>


        <div class="account-grid">

          {
            companies.map((company) => (

              <article class="account-card">

                <div class="account-top">

                  <div class="mini-logo">

                    {
                      company.logo ? (

                        <img
                          src={company.logo}
                          alt={`${company.name} logo`}
                        />

                      ) : (

                        company.logoPlaceholder

                      )
                    }

                  </div>


                  <div class="account-name">

                    <strong>
                      {company.name}
                    </strong>

                    <span>
                      {company.companyType}
                    </span>

                  </div>

                </div>


                <div class="fit-line">

                  <span>
                    Bardin ICP fit
                  </span>

                  <strong>
                    {company.totalScore}
                  </strong>

                </div>


                <div class="big-track" aria-hidden="true">

                  <div
                    class="bar"
                    style={`width:${company.totalScore}%`}
                  />

                </div>


                <p class="reason">
                  {company.rankReason}
                </p>


                <a
                  class="open-link"
                  href={`/bardin/${company.slug}`}
                >
                  Explore {company.shortName} →
                </a>

              </article>

            ))
          }

        </div>

      </section>


      <!-- COMPARISON -->

      <section>

        <div class="section-head">

          <h2>
            ICP fit comparison
          </h2>

          <p>
            Research score only. It measures structural alignment with
            Bardin's use case, not likelihood to buy.
          </p>

        </div>


        <div class="comparison">

          {
            [...companies]
              .sort((a, b) => b.totalScore - a.totalScore)
              .map((company) => (

                <div class="compare-row">

                  <span class="compare-name">
                    {company.shortName}
                  </span>


                  <div
                    class="compare-track"
                    aria-hidden="true"
                  >

                    <div
                      class="compare-fill"
                      style={`width:${company.totalScore}%`}
                    />

                  </div>


                  <span class="compare-score">
                    {company.totalScore}
                  </span>

                </div>

              ))
          }

        </div>

      </section>


      <!-- OPPORTUNITY PROFILE -->

      <section>

        <div class="section-head">

          <h2>
            Opportunity profile
          </h2>

          <p>
            Each dimension is scored from 0–20 from public evidence.
            The bars make the trade-offs visible instead of hiding
            everything inside one total score.
          </p>

        </div>


        <div class="profiles">

          {
            companies.map((company) => (

              <article class="profile-card">

                <h3>
                  {company.name}
                </h3>


                {
                  company.scoreBreakdown.map((metric) => (

                    <div class="metric">

                      <div class="metric-head">

                        <span>
                          {metric.label}
                        </span>

                        <strong>
                          {metric.score}/{metric.max}
                        </strong>

                      </div>


                      <div
                        class="metric-track"
                        aria-hidden="true"
                      >

                        <div
                          class="bar"
                          style={`width:${(metric.score / metric.max) * 100}%`}
                        />

                      </div>

                    </div>

                  ))
                }

              </article>

            ))
          }

        </div>

      </section>


      <!-- METHOD -->

      <section class="method">

        <strong>Method:</strong>
        public company signals → structured research →
        relevance classification → five-part ICP score →
        pain hypothesis → human review → discovery question
        and GTM strategy.

        A high score means "worth investigating,"
        not "confirmed customer pain."

      </section>


      <!-- FOOTER -->

      <footer>
        AI-assisted research · Human reviewed · Public sources linked
        on each account page · Scores and hypotheses are for
        prioritization and validation.
      </footer>

    </main>
  </body>
</html>
