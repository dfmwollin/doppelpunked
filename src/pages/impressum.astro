        <span
          data-de="Telefon: +49 7127 9349678"
          data-en="Telephone: +49 7127 9349678"
        >
          Telefon: +49 7127 9349678
        </span>
      </p>

      <h2
        data-de="Verantwortlich für redaktionelle Inhalte"
        data-en="Responsible for editorial content"
      >
        Verantwortlich für redaktionelle Inhalte
      </h2>

      <p>
        David Wollin<br />
        Ziegelweg 8<br />
        72141 Walddorfhäslach<br />

        <span
          data-de="Deutschland"
          data-en="Germany"
        >
          Deutschland
        </span>
