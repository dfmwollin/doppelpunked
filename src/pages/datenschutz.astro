---
import BaseLayout from "../layouts/BaseLayout.astro";
---
<BaseLayout
  title="Datenschutz — :Doppelpunked"
  description="Datenschutzhinweise von :Doppelpunked."
>
  <section class="page-hero">
    <div class="container">
      <p class="eyebrow">Rechtliches</p>
      <h1>Datenschutz</h1>
      <p class="lead">
        Platzhalter: Beschreibe Hosting, Server-Logs, Kontaktaufnahme,
        eingebundene Dienste und mögliche Analysewerkzeuge. Verwende keine
        pauschale Vorlage ungeprüft.
      </p>
    </div>
  </section>
</BaseLayout>
