---
import BaseLayout from "../layouts/BaseLayout.astro";
---
<BaseLayout
  title=":Doppelpunked — David Wollin"
  description="Technik, Kommunikation, Bildung und KI verständlich und praktisch verbinden."
>
  <section class="page-hero">
    <div class="container">
      <p class="eyebrow">Technik · Kommunikation · Bildung · KI</p>
      <h1>Komplexe Themen klar machen und praktisch umsetzen.</h1>
      <p class="lead">
        Ich verbinde Technikverständnis, Produktdenken, Kommunikation,
        Bildung und künstliche Intelligenz, um aus Ideen verständliche
        und nützliche Lösungen zu machen.
      </p>
      <div class="button-row">
        <a class="button button-primary" href="/projects">Projekte ansehen</a>
        <a class="button button-secondary" href="/contact">Kontakt aufnehmen</a>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <p class="eyebrow">Schwerpunkte</p>
      <h2>Was ich einbringe</h2>
      <div class="grid">
        <article class="card">
          <h3>KI & Arbeitsabläufe</h3>
          <p>KI praxisnah einführen, Abläufe verbessern und Wissen zugänglich machen.</p>
        </article>
        <article class="card">
          <h3>Produkt & technisches Marketing</h3>
          <p>Komplexe Produkte klar positionieren und ihren Nutzen überzeugend kommunizieren.</p>
        </article>
        <article class="card">
          <h3>Training & Bildung</h3>
          <p>Technische und digitale Inhalte für unterschiedliche Zielgruppen verständlich machen.</p>
        </article>
        <article class="card">
          <h3>Kommunikation & Präsentation</h3>
          <p>Zusammenhänge strukturieren, visualisieren und Menschen ins Handeln bringen.</p>
        </article>
      </div>
    </div>
  </section>
</BaseLayout>
