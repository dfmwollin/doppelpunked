---
import BaseLayout from "../layouts/BaseLayout.astro";

const email = "david@doppelpunked.com";

const de = `mailto:${email}?subject=${encodeURIComponent(
  "Anfrage zu Wissenssicherung und Wissenstransfer"
)}`;

const en = `mailto:${email}?subject=${encodeURIComponent(
  "Knowledge capture and transfer inquiry"
)}`;
---

<BaseLayout
  titleDe=":Doppelpunked — Wissenssicherung & Wissenstransfer"
  titleEn=":Doppelpunked — Knowledge Capture & Transfer"
  descriptionDe="Wissenssicherung und Wissenstransfer für technische KMU im DACH-Raum: Erfahrungswissen erfassen, strukturieren und für andere nutzbar machen."
  descriptionEn="Knowledge capture and transfer for technical SMEs: capturing expert know-how, structuring it clearly and making it usable for others."
>
  <section class="page-hero">
    <div class="page-hero-inner">
      <h1>
        <span
          data-de="Wissen im Kopf? Machen wir es "
          data-en="Knowledge in people's heads? Let’s make it "
        >
          Wissen im Kopf? Machen wir es
        </span>

        <span class="glass-word" data-de="klar" data-en="clear">
          klar
        </span>

        <span data-de=" und nutzbar." data-en=" and usable.">
          und nutzbar.
        </span>
      </h1>

      <p
        class="lead"
        data-de="In vielen Unternehmen steckt entscheidendes Erfahrungswissen in den Köpfen einzelner Mitarbeitender. Ich helfe technischen KMU, dieses Wissen zu sichern, zu strukturieren und so aufzubereiten, dass andere damit arbeiten können – zum Beispiel als SOPs, Checklisten, Onboarding- oder Lernmaterial."
        data-en="In many companies, critical know-how lives in the heads of individual employees. I help technical SMEs capture that knowledge, structure it and turn it into something others can actually use — such as SOPs, checklists, onboarding or learning materials."
      >
        In vielen Unternehmen steckt entscheidendes Erfahrungswissen in den
        Köpfen einzelner Mitarbeitender. Ich helfe technischen KMU, dieses
        Wissen zu sichern, zu strukturieren und so aufzubereiten, dass andere
        damit arbeiten können – zum Beispiel als SOPs, Checklisten, Onboarding-
        oder Lernmaterial.
      </p>

      <div class="hero-actions">
        <a
          class="button button-primary"
          href="/services"
          data-de="Wissenstransfer ansehen"
          data-en="Explore knowledge transfer"
        >
          Wissenstransfer ansehen
        </a>

        <a
          class="button button-secondary language-mail-link"
          href={de}
          data-mail-de={de}
          data-mail-en={en}
          data-de="Erstgespräch anfragen"
          data-en="Start a conversation"
        >
          Erstgespräch anfragen
        </a>
      </div>
    </div>
  </section>

  <section class="content-section">
    <div class="content-inner">
      <div class="section-heading reveal">
        <h2
          data-de="Wissen darf nicht mit Menschen gehen."
          data-en="Knowledge shouldn't walk out the door."
        >
          Wissen darf nicht mit Menschen gehen.
        </h2>
      </div>

      <p
        class="section-copy reveal"
        data-de="Wenn langjährige Mitarbeitende wechseln oder in Rente gehen, verschwinden oft undokumentierte Abläufe, Ausnahmen und Erfahrungswerte. Genau dieses Wissen ist für Nachfolger, neue Mitarbeitende und stabile Prozesse besonders wertvoll."
        data-en="When experienced employees change roles or retire, undocumented processes, exceptions and lessons learned can disappear with them. That knowledge is especially valuable for successors, new employees and reliable day-to-day operations."
      >
        Wenn langjährige Mitarbeitende wechseln oder in Rente gehen,
        verschwinden oft undokumentierte Abläufe, Ausnahmen und Erfahrungswerte.
        Genau dieses Wissen ist für Nachfolger, neue Mitarbeitende und stabile
        Prozesse besonders wertvoll.
      </p>
    </div>
  </section>

  <section class="content-section">
    <div class="content-inner cards">
      <article class="focus-card reveal">
        <div class="card-top">
          <span class="number">01</span>
          <span class="card-icon" aria-hidden="true">✦</span>
        </div>

        <h3
          data-de="Kritisches Wissen erkennen"
          data-en="Identify critical knowledge"
        >
          Kritisches Wissen erkennen
        </h3>

        <p
          data-de="Wo hängt ein Prozess von einzelnen Personen ab? Gemeinsam bestimmen wir, welches Wissen zuerst gesichert werden sollte."
          data-en="Where does a process depend on individual people? Together, we identify which knowledge should be captured first."
        >
          Wo hängt ein Prozess von einzelnen Personen ab? Gemeinsam bestimmen
          wir, welches Wissen zuerst gesichert werden sollte.
        </p>
      </article>

      <article class="focus-card reveal">
        <div class="card-top">
          <span class="number">02</span>
          <span class="card-icon" aria-hidden="true">↗</span>
        </div>

        <h3
          data-de="Erfahrungswissen erfassen"
          data-en="Capture expert know-how"
        >
          Erfahrungswissen erfassen
        </h3>

        <p
          data-de="Durch Interviews, Beobachtung und vorhandene Unterlagen holen wir Praxiswissen aus den Köpfen und aus dem Arbeitsalltag heraus."
          data-en="Through interviews, observation and existing documents, we capture the practical knowledge that usually stays in people's heads and daily routines."
        >
          Durch Interviews, Beobachtung und vorhandene Unterlagen holen wir
          Praxiswissen aus den Köpfen und aus dem Arbeitsalltag heraus.
        </p>
      </article>

      <article class="focus-card reveal">
        <div class="card-top">
          <span class="number">03</span>
          <span class="card-icon" aria-hidden="true">◎</span>
        </div>

        <h3 data-de="Klar strukturieren" data-en="Structure it clearly">
          Klar strukturieren
        </h3>

        <p
          data-de="Aus Notizen und Erfahrungswissen entstehen verständliche Abläufe, SOPs, Checklisten, FAQs oder Prozessübersichten."
          data-en="Notes and expert know-how become clear workflows, SOPs, checklists, FAQs or process overviews."
        >
          Aus Notizen und Erfahrungswissen entstehen verständliche Abläufe,
          SOPs, Checklisten, FAQs oder Prozessübersichten.
        </p>
      </article>

      <article class="focus-card reveal">
        <div class="card-top">
          <span class="number">04</span>
          <span class="card-icon brand-icon" aria-hidden="true">:</span>
        </div>

        <h3
          data-de="Weitergeben & nutzen"
          data-en="Transfer & use"
        >
          Weitergeben & nutzen
        </h3>

        <p
          data-de="Das Wissen wird für Onboarding, Vertretung, Schulung oder den täglichen Zugriff aufbereitet – auf Deutsch und Englisch, wenn nötig."
          data-en="The knowledge is prepared for onboarding, cover, training or everyday access — in German and English when needed."
        >
          Das Wissen wird für Onboarding, Vertretung, Schulung oder den
          täglichen Zugriff aufbereitet – auf Deutsch und Englisch, wenn nötig.
        </p>
      </article>
    </div>
  </section>

  <section class="ask-section">
    <div class="content-inner ask-inner reveal">
      <div class="ask-intro">
        <p class="section-label">: ask</p>

        <h2>
          <span
            data-de="Wo steckt bei euch kritisches Wissen?"
            data-en="Where does critical knowledge sit in your organization?"
          >
            Wo steckt bei euch kritisches Wissen?
          </span>
        </h2>

        <p
          class="ask-lead"
          data-de="Frag nach Wissenssicherung, dem Ablauf eines Wissenstransfers, möglichen Ergebnissen oder meiner Arbeitsweise."
          data-en="Ask about knowledge capture, how a knowledge transfer works, possible outcomes or how I work."
        >
          Frag nach Wissenssicherung, dem Ablauf eines Wissenstransfers,
          möglichen Ergebnissen oder meiner Arbeitsweise.
        </p>
      </div>

      <div class="ask-interface">
        <form class="ask-form" id="ask-form">
          <label class="sr-only" for="ask-input">
            Frage
          </label>

          <div class="ask-input-wrap">
            <input
              id="ask-input"
              class="ask-input"
              type="text"
              autocomplete="off"
              maxlength="180"
              placeholder="Wie läuft ein Wissenstransfer ab?"
              data-placeholder-de="Wie läuft ein Wissenstransfer ab?"
              data-placeholder-en="How does a knowledge transfer work?"
            />

            <button
              class="ask-submit"
              type="submit"
              aria-label="Frage senden"
            >
              →
            </button>
          </div>
        </form>

        <div class="ask-suggestions">
          <button
            type="button"
            class="ask-suggestion"
            data-question-de="Wie läuft ein Wissenstransfer ab?"
            data-question-en="How does a knowledge transfer work?"
          >
            Wie läuft ein Wissenstransfer ab?
          </button>

          <button
            type="button"
            class="ask-suggestion"
            data-question-de="Was entsteht am Ende?"
            data-question-en="What do we get at the end?"
          >
            Was entsteht am Ende?
          </button>

          <button
            type="button"
            class="ask-suggestion"
            data-question-de="Wann lohnt sich Wissenssicherung?"
            data-question-en="When is knowledge capture worthwhile?"
          >
            Wann lohnt sich Wissenssicherung?
          </button>

          <button
            type="button"
            class="ask-suggestion"
            data-question-de="Warum heißt es :Doppelpunked?"
            data-question-en="Why is it called :Doppelpunked?"
          >
            Warum heißt es :Doppelpunked?
          </button>
        </div>

        <div
          class="ask-answer"
          id="ask-answer"
          aria-live="polite"
          hidden
        >
          <div
            class="ask-thinking"
            id="ask-thinking"
            aria-hidden="true"
          >
            <span></span>
            <span></span>
          </div>

          <div id="ask-answer-content"></div>
        </div>
      </div>
    </div>
  </section>

  <section class="contact-section">
    <div class="contact-inner reveal">
      <h2
        data-de="Welches Wissen darf bei euch nicht verloren gehen?"
        data-en="What knowledge can your organization not afford to lose?"
      >
        Welches Wissen darf bei euch nicht verloren gehen?
      </h2>

      <div class="contact-actions">
        <a
          class="button button-primary language-mail-link"
          href={de}
          data-mail-de={de}
          data-mail-en={en}
          data-de="Unverbindlich besprechen"
          data-en="Talk it through"
        >
          Unverbindlich besprechen
        </a>
      </div>
    </div>
  </section>

  <script is:inline>
    const askForm =
      document.querySelector("#ask-form");

    const askInput =
      document.querySelector("#ask-input");

    const askAnswer =
      document.querySelector("#ask-answer");

    const askAnswerContent =
      document.querySelector("#ask-answer-content");

    const askThinking =
      document.querySelector("#ask-thinking");

    const askSuggestions =
      document.querySelectorAll(".ask-suggestion");

    const askContent = {
      de: {
        david: {
          title: "Technik verstehen. Wissen übersetzen.",
          text:
            "David verbindet technisches Verständnis mit Produktmanagement, Kommunikation, Unterricht und praktischer KI-Anwendung. Dadurch kann er Fachwissen nicht nur erfassen, sondern so strukturieren und erklären, dass andere es tatsächlich verstehen und anwenden können.",
          links: [
            ["Mehr über David", "/about"],
            ["Projekte ansehen", "/projects"]
          ]
        },

        services: {
          title: "Wissen sichern, strukturieren, weitergeben.",
          text:
            ":Doppelpunked unterstützt Unternehmen dabei, wichtiges Erfahrungswissen aus den Köpfen einzelner Mitarbeitender zu holen und für andere nutzbar zu machen — zum Beispiel als SOPs, Checklisten, Prozessübersichten oder Onboarding-Material.",
          links: [
            ["Angebot ansehen", "/services"],
            ["Kontakt aufnehmen", "/contact"]
          ]
        },

        process: {
          title: "So läuft es typischerweise ab:",
          text:
            "Zuerst identifizieren wir kritisches Wissen. Dann wird es durch Gespräche, Beobachtung und vorhandene Unterlagen erfasst, strukturiert und schließlich in eine Form gebracht, mit der andere zuverlässig arbeiten oder lernen können.",
          links: [
            ["Wissenstransfer ansehen", "/services"],
            ["Kontakt aufnehmen", "/contact"]
          ]
        },

        outputs: {
          title: "Das Ergebnis muss nutzbar sein.",
          text:
            "Je nach Bedarf können SOPs, Checklisten, Prozesskarten, FAQs, kurze Anleitungen, Onboarding-Unterlagen, Lernmaterialien oder eine strukturierte Wissensbasis entstehen.",
          links: [
            ["Angebot ansehen", "/services"],
            ["Projekte entdecken", "/projects"]
          ]
        },

        risk: {
          title: "Besonders dann, wenn Wissen an Personen hängt.",
          text:
            "Wissenssicherung lohnt sich zum Beispiel vor Ruhestand oder Rollenwechseln, bei schwierigem Onboarding, fehlender Vertretung oder wenn wichtige Abläufe nur wenige erfahrene Mitarbeitende wirklich beherrschen.",
          links: [
            ["Angebot ansehen", "/services"],
            ["Erstgespräch anfragen", "/contact"]
          ]
        },

        projects: {
          title: "Vom Expertenwissen zum nutzbaren Ergebnis.",
          text:
            "Die Beispiele reichen von technischer Dokumentation und Produktkommunikation bis zu Schulung, Visualisierung und praktischen Lernmaterialien. Der gemeinsame Nenner: komplexes Wissen wird klarer und für andere anwendbar.",
          links: [
            ["Projekte entdecken", "/projects"]
          ]
        },

        ai: {
          title: "KI hilft — Erfahrung bleibt menschlich.",
          text:
            "KI kann bei Transkription, Strukturierung, Übersetzung, Recherche und Pflege von Wissen unterstützen. Entscheidend bleiben aber das Erfahrungswissen der Menschen, der Kontext und eine fachliche Prüfung der Ergebnisse.",
          links: [
            ["Angebot ansehen", "/services"],
            ["Projekte ansehen", "/projects"]
          ]
        },

        brand: {
          title: "Der Doppelpunkt ist die Idee.",
          text:
            "Er verbindet zwei Seiten: Experte : Nachfolger. Erfahrung : Struktur. Wissen : Anwendung. :Doppelpunked steht für diese Verbindung — und für das, was danach weitergegeben werden kann.",
          links: [
            ["Mehr zur Idee", "/about"]
          ]
        },

        education: {
          title: "Auch Bildung ist Wissenstransfer.",
          text:
            "Für Bildungseinrichtungen kann :Doppelpunked Fachwissen in verständliche Lernmaterialien, Visualisierungen, Anleitungen oder praktische Lernformate übersetzen.",
          links: [
            ["Mehr erfahren", "/about"],
            ["Projekte ansehen", "/projects"]
          ]
        },

        fallback: {
          title: "Das weiß : ask noch nicht.",
          text:
            "Diese erste Version kennt nur ausgewählte Themen. Aber David wahrscheinlich schon. Schreib ihm direkt oder schau dir das Angebot an.",
          links: [
            ["David fragen", "/contact"],
            ["Angebot ansehen", "/services"]
          ]
        }
      },

      en: {
        david: {
          title: "Understand technology. Translate knowledge.",
          text:
            "David combines technical understanding with product management, communication, teaching and practical AI use. This allows him not only to capture expert knowledge, but to structure and explain it so that others can actually understand and apply it.",
          links: [
            ["About David", "/about"],
            ["View projects", "/projects"]
          ]
        },

        services: {
          title: "Capture, structure and transfer knowledge.",
          text:
            ":Doppelpunked helps organizations capture important know-how from individual employees and make it useful for others — for example as SOPs, checklists, process overviews or onboarding materials.",
          links: [
            ["Explore services", "/services"],
            ["Get in touch", "/contact"]
          ]
        },

        process: {
          title: "A typical transfer looks like this:",
          text:
            "First, we identify critical knowledge. Then we capture it through conversations, observation and existing documents, structure it clearly and turn it into something others can reliably work or learn with.",
          links: [
            ["Explore knowledge transfer", "/services"],
            ["Get in touch", "/contact"]
          ]
        },

        outputs: {
          title: "The result has to be usable.",
          text:
            "Depending on the need, the outcome might include SOPs, checklists, process maps, FAQs, short guides, onboarding materials, learning resources or a structured knowledge base.",
          links: [
            ["Explore services", "/services"],
            ["View projects", "/projects"]
          ]
        },

        risk: {
          title: "Especially when knowledge depends on individuals.",
          text:
            "Knowledge capture is particularly useful before retirement or role changes, when onboarding takes too long, when there is little backup, or when only a few experienced employees truly understand an important process.",
          links: [
            ["Explore services", "/services"],
            ["Start a conversation", "/contact"]
          ]
        },

        projects: {
          title: "From expert knowledge to something useful.",
          text:
            "The examples range from technical documentation and product communication to training, visualization and practical learning materials. The common thread is turning complex knowledge into something clearer and easier for others to use.",
          links: [
            ["Explore projects", "/projects"]
          ]
        },

        ai: {
          title: "AI helps — experience stays human.",
          text:
            "AI can support transcription, structuring, translation, research and knowledge maintenance. But the experience of the people involved, the context and expert review remain essential.",
          links: [
            ["Explore services", "/services"],
            ["View projects", "/projects"]
          ]
        },

        brand: {
          title: "The colon is the idea.",
          text:
            "It connects two sides: expert : successor. Experience : structure. Knowledge : application. :Doppelpunked is about making that connection — and making knowledge transferable.",
          links: [
            ["About the idea", "/about"]
          ]
        },

        education: {
          title: "Education is knowledge transfer too.",
          text:
            "For educational institutions, :Doppelpunked can turn specialist knowledge into clear learning materials, visualizations, instructions or practical learning formats.",
          links: [
            ["Learn more", "/about"],
            ["View projects", "/projects"]
          ]
        },

        fallback: {
          title: ": ask doesn't know that yet.",
          text:
            "This first version only knows selected topics. David probably knows more. Ask him directly or explore the services.",
          links: [
            ["Ask David", "/contact"],
            ["Explore services", "/services"]
          ]
        }
      }
    };

    function getAskLanguage() {
      return document.documentElement.lang === "en"
        ? "en"
        : "de";
    }

    function findAskTopic(question) {
      const q = question
        .toLowerCase()
        .trim();

      const groups = [
        {
          topic: "brand",
          words: [
            "doppelpunked",
            "doppelpunkt",
            "name",
            "colon",
            "brand",
            "marke",
            "warum heißt",
            "why"
          ]
        },

        {
          topic: "ai",
          words: [
            "ki",
            "ai",
            "chatgpt",
            "automation",
            "automatisierung",
            "künstliche intelligenz",
            "artificial intelligence"
          ]
        },

        {
          topic: "process",
          words: [
            "ablauf",
            "ablaufen",
            "läuft",
            "vorgehen",
            "prozess",
            "schritte",
            "sprint",
            "process",
            "steps",
            "how does",
            "how do"
          ]
        },

        {
          topic: "outputs",
          words: [
            "entsteht",
            "ergebnis",
            "output",
            "sop",
            "checkliste",
            "onboarding",
            "material",
            "deliverable",
            "result",
            "outcome",
            "get at the end"
          ]
        },

        {
          topic: "risk",
          words: [
            "wann",
            "lohnt",
            "risiko",
            "verloren",
            "verlust",
            "rente",
            "ruhestand",
            "ausscheiden",
            "experte",
            "nachfolger",
            "risk",
            "retire",
            "retirement",
            "leave",
            "worthwhile",
            "critical"
          ]
        },

        {
          topic: "projects",
          words: [
            "projekt",
            "projekte",
            "projects",
            "project",
            "beispiel",
            "examples",
            "referenz",
            "portfolio"
          ]
        },

        {
          topic: "education",
          words: [
            "schule",
            "unterricht",
            "bildung",
            "lernen",
            "training",
            "education",
            "teaching",
            "teacher",
            "learning"
          ]
        },

        {
          topic: "services",
          words: [
            "helfen",
            "hilfe",
            "unternehmen",
            "firma",
            "angebot",
            "service",
            "services",
            "help",
            "company",
            "business",
            "wissen",
            "wissenssicherung",
            "wissenstransfer",
            "knowledge",
            "transfer",
            "zusammenarbeiten",
            "collaborate"
          ]
        },

        {
          topic: "david",
          words: [
            "david",
            "wer",
            "who",
            "person",
            "hintergrund",
            "background",
            "erfahrung",
            "experience",
            "macht"
          ]
        }
      ];

      for (const group of groups) {
        if (
          group.words.some(
            (word) => q.includes(word)
          )
        ) {
          return group.topic;
        }
      }

      return "fallback";
    }

    function renderAskAnswer(topic) {
      if (
        !askAnswer ||
        !askAnswerContent
      ) {
        return;
      }

      const language =
        getAskLanguage();

      const answer =
        askContent[language][topic] ||
        askContent[language].fallback;

      askAnswer.hidden = false;

      askAnswer.classList.remove(
        "is-ready"
      );

      askAnswerContent.innerHTML = "";

      if (askThinking) {
        askThinking.hidden = false;
      }

      window.setTimeout(() => {
        if (askThinking) {
          askThinking.hidden = true;
        }

        const links = answer.links
          .map(
            ([label, url]) =>
              `<a href="${url}">${label} <span aria-hidden="true">→</span></a>`
          )
          .join("");

        askAnswerContent.innerHTML = `
          <p class="ask-answer-label">
            ${answer.title}
          </p>

          <p class="ask-answer-text">
            ${answer.text}
          </p>

          <div class="ask-answer-links">
            ${links}
          </div>
        `;

        askAnswer.classList.add(
          "is-ready"
        );
      }, 420);
    }

    function askQuestion(question) {
      if (!question.trim()) {
        return;
      }

      const topic =
        findAskTopic(question);

      renderAskAnswer(topic);
    }

    askForm?.addEventListener(
      "submit",
      (event) => {
        event.preventDefault();

        if (askInput) {
          askQuestion(
            askInput.value
          );
        }
      }
    );

    askSuggestions.forEach(
      (button) => {
        button.addEventListener(
          "click",
          () => {
            const language =
              getAskLanguage();

            const question =
              language === "en"
                ? button.dataset.questionEn
                : button.dataset.questionDe;

            if (!question) {
              return;
            }

            if (askInput) {
              askInput.value =
                question;
            }

            askQuestion(question);
          }
        );
      }
    );

    function updateAskLanguage() {
      const language =
        getAskLanguage();

      if (askInput) {
        askInput.placeholder =
          language === "en"
            ? askInput.dataset.placeholderEn
            : askInput.dataset.placeholderDe;
      }

      askSuggestions.forEach(
        (button) => {
          button.textContent =
            language === "en"
              ? button.dataset.questionEn
              : button.dataset.questionDe;
        }
      );
    }

    updateAskLanguage();

    const askLanguageObserver =
      new MutationObserver(() => {
        updateAskLanguage();
      });

    askLanguageObserver.observe(
      document.documentElement,
      {
        attributes: true,
        attributeFilter: ["lang"]
      }
    );
  </script>
</BaseLayout>