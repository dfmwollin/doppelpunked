---
import BaseLayout from "../layouts/BaseLayout.astro";
const email="doppelpunked@gmail.com";const de=`mailto:${email}?subject=${encodeURIComponent('Anfrage über doppelpunked.com')}`;const en=`mailto:${email}?subject=${encodeURIComponent('Inquiry via doppelpunked.com')}`;
---
<BaseLayout titleDe=":Doppelpunked — David Wollin" titleEn=":Doppelpunked — David Wollin" descriptionDe="Technik, Kommunikation, Bildung und KI verständlich und praktisch verbinden." descriptionEn="Connecting technology, communication, education and AI in clear and practical ways."><section class="hero"><div class="hero-inner"><p class="eyebrow" data-de="Technik · Kommunikation · Bildung · KI" data-en="Technology · Communication · Education · AI">Technik · Kommunikation · Bildung · KI</p><h1 data-de="Komplexe Themen klar machen und praktisch umsetzen." data-en="Making complex ideas clear and practical.">Komplexe Themen klar machen und praktisch umsetzen.</h1><p class="hero-text" data-de="Ich verbinde Technikverständnis, Produktdenken, Kommunikation, Bildung und künstliche Intelligenz, um aus Ideen verständliche und nützliche Lösungen zu machen." data-en="I connect technical understanding, product thinking, communication, education and artificial intelligence to turn ideas into clear and useful solutions.">Ich verbinde Technikverständnis, Produktdenken, Kommunikation, Bildung und künstliche Intelligenz, um aus Ideen verständliche und nützliche Lösungen zu machen.</p><div class="hero-actions"><a class="button button-primary" href="/services" data-de="Angebot ansehen" data-en="Explore services">Angebot ansehen</a><a class="button button-secondary language-mail-link" href={de} data-mail-de={de} data-mail-en={en} data-de="Kontakt aufnehmen" data-en="Get in touch">Kontakt aufnehmen</a></div></div></section><section class="content-section"><div class="content-inner section-grid reveal"><div><p class="section-label" data-de="Profil" data-en="Profile">Profil</p><h2 data-de="Zwischen Technik, Menschen und Ideen." data-en="Between technology, people and ideas.">Zwischen Technik, Menschen und Ideen.</h2></div><p class="section-copy" data-de="Mein Hintergrund umfasst Bauingenieurwesen, Produktmanagement, Medizintechnik, Marketing, Unterricht und die praktische Anwendung moderner KI-Werkzeuge." data-en="My background spans civil engineering, product management, medical technology, marketing, teaching and the practical application of modern AI tools.">Mein Hintergrund umfasst Bauingenieurwesen, Produktmanagement, Medizintechnik, Marketing, Unterricht und die praktische Anwendung moderner KI-Werkzeuge.</p></div></section><section class="content-section"><div class="content-inner"><p class="section-label reveal" data-de="Schwerpunkte" data-en="Focus">Schwerpunkte</p><div class="cards"><article class="focus-card reveal"><div class="card-top"><span class="number">01</span><span class="card-icon">✦</span></div><h3 data-de="KI & Arbeitsabläufe" data-en="AI & Workflows">KI & Arbeitsabläufe</h3><p data-de="KI praxisnah einführen, Abläufe verbessern und Wissen leichter zugänglich machen." data-en="Introduce AI practically, improve workflows and make knowledge easier to access.">KI praxisnah einführen, Abläufe verbessern und Wissen leichter zugänglich machen.</p></article><article class="focus-card reveal"><div class="card-top"><span class="number">02</span><span class="card-icon">↗</span></div><h3 data-de="Produkt & technisches Marketing" data-en="Product & Technical Marketing">Produkt & technisches Marketing</h3><p data-de="Komplexe Produkte klar positionieren und ihren Nutzen überzeugend kommunizieren." data-en="Position complex products clearly and communicate their value convincingly.">Komplexe Produkte klar positionieren und ihren Nutzen überzeugend kommunizieren.</p></article><article class="focus-card reveal"><div class="card-top"><span class="number">03</span><span class="card-icon">◎</span></div><h3 data-de="Training & Bildung" data-en="Training & Education">Training & Bildung</h3><p data-de="Technische und digitale Inhalte für unterschiedliche Zielgruppen verständlich machen." data-en="Make technical and digital content understandable for different audiences.">Technische und digitale Inhalte für unterschiedliche Zielgruppen verständlich machen.</p></article><article class="focus-card reveal"><div class="card-top"><span class="number">04</span><span class="card-icon">:</span></div><h3 data-de="Kommunikation & Präsentation" data-en="Communication & Presentation">Kommunikation & Präsentation</h3><p data-de="Zusammenhänge strukturieren, visualisieren und Menschen ins Handeln bringen." data-en="Structure and visualize ideas so people can understand and act.">Zusammenhänge strukturieren, visualisieren und Menschen ins Handeln bringen.</p></article></div></div></section><section class="contact-section"><div class="contact-inner reveal"><p class="section-label" data-de="Kontakt" data-en="Contact">Kontakt</p><h2 data-de="Was könnten wir gemeinsam klarer, einfacher oder besser machen?" data-en="What could we make clearer, simpler or better together?">Was könnten wir gemeinsam klarer, einfacher oder besser machen?</h2><a class="button button-primary language-mail-link" href={de} data-mail-de={de} data-mail-en={en} data-de="E-Mail schreiben" data-en="Send an email">E-Mail schreiben</a></div></section></BaseLayout>
