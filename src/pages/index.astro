---
const pageTitle = ":Doppelpunked — David Wollin";
const pageDescription =
  "Technik, Kommunikation, Bildung und KI verständlich und praktisch verbinden.";

const emailAddress = "doppelpunked@gmail.com";

const germanSubject = encodeURIComponent(
  "Anfrage über doppelpunked.com"
);

const germanBody = encodeURIComponent(
  `Hallo David,

ich bin über doppelpunked.com auf dich aufmerksam geworden.

Ich interessiere mich für:
[Bitte Thema oder Projekt eintragen]

Kurz zu meiner Anfrage:
[Bitte Nachricht eintragen]

Viele Grüße
[Name]`
);

const englishSubject = encodeURIComponent(
  "Inquiry via doppelpunked.com"
);

const englishBody = encodeURIComponent(
  `Hello David,

I found you through doppelpunked.com.

I am interested in:
[Please enter the topic or project]

A short description of my inquiry:
[Please enter your message]

Best regards,
[Name]`
);

const germanMailLink =
  `mailto:${emailAddress}?subject=${germanSubject}&body=${germanBody}`;

const englishMailLink =
  `mailto:${emailAddress}?subject=${englishSubject}&body=${englishBody}`;
---

<!doctype html>
<html lang="de">
  <head>
    <meta charset="UTF-8" />

    <meta
      name="viewport"
      content="width=device-width, initial-scale=1"
    />

    <meta name="description" content={pageDescription} />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="alternate icon" href="/favicon.ico" />

    <title>{pageTitle}</title>

    <script is:inline>
      document.documentElement.classList.add("js");
    </script>
  </head>

  <body>
    <header class="site-header">
      <div class="header-inner">
        <a class="logo" href="#top" aria-label="Doppelpunked Startseite">
          :Doppelpunked
        </a>

        <nav class="desktop-nav" aria-label="Hauptnavigation">
          <a href="#about" data-de="Über mich" data-en="About">
            Über mich
          </a>

          <a href="#work" data-de="Schwerpunkte" data-en="Focus">
            Schwerpunkte
          </a>

          <a href="#contact" data-de="Kontakt" data-en="Contact">
            Kontakt
          </a>
        </nav>

        <div class="language-switch" aria-label="Sprache auswählen">
          <button
            class="language-button active"
            type="button"
            data-language="de"
            aria-pressed="true"
          >
            DE
          </button>

          <button
            class="language-button"
            type="button"
            data-language="en"
            aria-pressed="false"
          >
            EN
          </button>
        </div>
      </div>
    </header>

    <main id="top">
      <section class="hero">
        <div class="hero-inner">
          <p
            class="eyebrow"
            data-de="Technik · Kommunikation · Bildung · KI"
            data-en="Technology · Communication · Education · AI"
          >
            Technik · Kommunikation · Bildung · KI
          </p>

          <h1
            data-de="Komplexe Themen klar machen und praktisch umsetzen."
            data-en="Making complex ideas clear and practical."
          >
            Komplexe Themen klar machen und praktisch umsetzen.
          </h1>

          <p
            class="hero-text"
            data-de="Ich verbinde Technikverständnis, Produktdenken, Kommunikation, Bildung und künstliche Intelligenz, um aus Ideen verständliche und nützliche Lösungen zu machen."
            data-en="I connect technical understanding, product thinking, communication, education and artificial intelligence to turn ideas into clear and useful solutions."
          >
            Ich verbinde Technikverständnis, Produktdenken, Kommunikation,
            Bildung und künstliche Intelligenz, um aus Ideen verständliche und
            nützliche Lösungen zu machen.
          </p>

          <div class="hero-actions">
            <a
              class="button button-primary"
              href="#work"
              data-de="Schwerpunkte ansehen"
              data-en="Explore my focus"
            >
              Schwerpunkte ansehen
            </a>

            <a
              class="button button-secondary language-mail-link"
              href={germanMailLink}
              data-mail-de={germanMailLink}
              data-mail-en={englishMailLink}
              data-de="Kontakt aufnehmen"
              data-en="Get in touch"
            >
              Kontakt aufnehmen
            </a>
          </div>
        </div>
      </section>

      <section id="about" class="content-section">
        <div class="section-grid reveal">
          <div>
            <p
              class="section-label"
              data-de="Profil"
              data-en="Profile"
            >
              Profil
            </p>

            <h2
              data-de="Zwischen Technik, Menschen und Ideen."
              data-en="Between technology, people and ideas."
            >
              Zwischen Technik, Menschen und Ideen.
            </h2>
          </div>

          <div>
            <p
              class="section-copy"
              data-de="Mein Hintergrund umfasst Bauingenieurwesen, Produktmanagement, Medizintechnik, Marketing, Unterricht und die praktische Anwendung moderner KI-Werkzeuge."
              data-en="My background spans civil engineering, product management, medical technology, marketing, teaching and the practical application of modern AI tools."
            >
              Mein Hintergrund umfasst Bauingenieurwesen, Produktmanagement,
              Medizintechnik, Marketing, Unterricht und die praktische
              Anwendung moderner KI-Werkzeuge.
            </p>
          </div>
        </div>
      </section>

      <section id="work" class="content-section">
        <div class="section-heading reveal">
          <p
            class="section-label"
            data-de="Schwerpunkte"
            data-en="Focus"
          >
            Schwerpunkte
          </p>

          <h2
            data-de="Was ich anbiete"
            data-en="What I offer"
          >
            Was ich anbiete
          </h2>
        </div>

        <div class="cards">
          <article class="focus-card reveal">
            <div class="card-top">
              <span class="number">01</span>
              <span class="card-icon" aria-hidden="true">✦</span>
            </div>

            <h3
              data-de="KI & Arbeitsabläufe"
              data-en="AI & Workflows"
            >
              KI & Arbeitsabläufe
            </h3>

            <p
              data-de="KI praxisnah einführen, sinnvolle Arbeitsabläufe entwickeln und wiederkehrende Aufgaben einfacher, schneller und transparenter machen."
              data-en="Introducing AI practically, designing useful workflows and making recurring tasks simpler, faster and more transparent."
            >
              KI praxisnah einführen, sinnvolle Arbeitsabläufe entwickeln und
              wiederkehrende Aufgaben einfacher, schneller und transparenter
              machen.
            </p>

            <ul>
              <li
                data-de="KI-Einführung und Schulung"
                data-en="AI adoption and training"
              >
                KI-Einführung und Schulung
              </li>

              <li
                data-de="Workflow-Optimierung"
                data-en="Workflow improvement"
              >
                Workflow-Optimierung
              </li>

              <li
                data-de="Automatisierung und Wissensmanagement"
                data-en="Automation and knowledge management"
              >
                Automatisierung und Wissensmanagement
              </li>
            </ul>
          </article>

          <article class="focus-card reveal">
            <div class="card-top">
              <span class="number">02</span>
              <span class="card-icon" aria-hidden="true">↗</span>
            </div>

            <h3
              data-de="Produkt & technisches Marketing"
              data-en="Product & Technical Marketing"
            >
              Produkt & technisches Marketing
            </h3>

            <p
              data-de="Komplexe Produkte klar positionieren, ihren Nutzen verständlich machen und Vertrieb sowie Markteinführung mit überzeugenden Inhalten unterstützen."
              data-en="Positioning complex products clearly, communicating their value and supporting sales and market launches with convincing content."
            >
              Komplexe Produkte klar positionieren, ihren Nutzen verständlich
              machen und Vertrieb sowie Markteinführung mit überzeugenden
              Inhalten unterstützen.
            </p>

            <ul>
              <li
                data-de="Positionierung und Nutzenargumentation"
                data-en="Positioning and value propositions"
              >
                Positionierung und Nutzenargumentation
              </li>

              <li
                data-de="Go-to-Market und Produkteinführung"
                data-en="Go-to-market and product launches"
              >
                Go-to-Market und Produkteinführung
              </li>

              <li
                data-de="Vertriebs- und Marketingmaterialien"
                data-en="Sales and marketing materials"
              >
                Vertriebs- und Marketingmaterialien
              </li>
            </ul>
          </article>

          <article class="focus-card reveal">
            <div class="card-top">
              <span class="number">03</span>
              <span class="card-icon" aria-hidden="true">◎</span>
            </div>

            <h3
              data-de="Training & Bildung"
              data-en="Training & Education"
            >
              Training & Bildung
            </h3>

            <p
              data-de="Lernangebote entwickeln, die technische und digitale Inhalte für Schüler, Fachkräfte und Organisationen verständlich und anwendbar machen."
              data-en="Designing learning experiences that make technical and digital subjects understandable and applicable for students, professionals and organizations."
            >
              Lernangebote entwickeln, die technische und digitale Inhalte für
              Schüler, Fachkräfte und Organisationen verständlich und anwendbar
              machen.
            </p>

            <ul>
              <li
                data-de="Workshops und Schulungen"
                data-en="Workshops and training"
              >
                Workshops und Schulungen
              </li>

              <li
                data-de="Deutsch, Englisch und zweisprachig"
                data-en="German, English and bilingual"
              >
                Deutsch, Englisch und zweisprachig
              </li>

              <li
                data-de="Praxisnahe Lernmaterialien"
                data-en="Practical learning resources"
              >
                Praxisnahe Lernmaterialien
              </li>
            </ul>
          </article>

          <article class="focus-card reveal">
            <div class="card-top">
              <span class="number">04</span>
              <span class="card-icon brand-icon" aria-hidden="true">:</span>
            </div>

            <h3
              data-de="Kommunikation & Präsentation"
              data-en="Communication & Presentation"
            >
              Kommunikation & Präsentation
            </h3>

            <p
              data-de="Technische Zusammenhänge strukturieren, visuell aufbereiten und so präsentieren, dass unterschiedliche Zielgruppen sie verstehen und ins Handeln kommen."
              data-en="Structuring technical subjects, presenting them visually and helping different audiences understand them and take action."
            >
              Technische Zusammenhänge strukturieren, visuell aufbereiten und
              so präsentieren, dass unterschiedliche Zielgruppen sie verstehen
              und ins Handeln kommen.
            </p>

            <ul>
              <li
                data-de="Präsentationen und Storytelling"
                data-en="Presentations and storytelling"
              >
                Präsentationen und Storytelling
              </li>

              <li
                data-de="Technische Dokumentation"
                data-en="Technical documentation"
              >
                Technische Dokumentation
              </li>

              <li
                data-de="Komplexes einfach erklären"
                data-en="Explaining complexity clearly"
              >
                Komplexes einfach erklären
              </li>
            </ul>
          </article>
        </div>
      </section>

      <section id="contact" class="contact-section">
        <div class="contact-inner reveal">
          <p
            class="section-label"
            data-de="Kontakt"
            data-en="Contact"
          >
            Kontakt
          </p>

          <h2
            data-de="Was könnten wir gemeinsam klarer, einfacher oder besser machen?"
            data-en="What could we make clearer, simpler or better together?"
          >
            Was könnten wir gemeinsam klarer, einfacher oder besser machen?
          </h2>

          <a
            class="button button-primary language-mail-link"
            href={germanMailLink}
            data-mail-de={germanMailLink}
            data-mail-en={englishMailLink}
            data-de="E-Mail schreiben"
            data-en="Send an email"
          >
            E-Mail schreiben
          </a>
        </div>
      </section>
    </main>

    <footer>
      <div class="footer-inner">
        <span>© {new Date().getFullYear()} David Wollin</span>
        <span>doppelpunked.com</span>
      </div>
    </footer>

    <script is:inline>
      const languageButtons = document.querySelectorAll("[data-language]");

      const translatedElements = document.querySelectorAll(
        "[data-de][data-en]"
      );

      const languageMailLinks = document.querySelectorAll(
        ".language-mail-link"
      );

      function setLanguage(language) {
        document.documentElement.lang = language;

        translatedElements.forEach((element) => {
          const translatedText = element.dataset[language];

          if (translatedText) {
            element.textContent = translatedText;
          }
        });

        languageMailLinks.forEach((link) => {
          const selectedMailLink =
            language === "en"
              ? link.dataset.mailEn
              : link.dataset.mailDe;

          if (selectedMailLink) {
            link.setAttribute("href", selectedMailLink);
          }
        });

        languageButtons.forEach((button) => {
          const isActive = button.dataset.language === language;

          button.classList.toggle("active", isActive);
          button.setAttribute("aria-pressed", String(isActive));
        });

        localStorage.setItem("doppelpunked-language", language);
      }

      languageButtons.forEach((button) => {
        button.addEventListener("click", () => {
          const selectedLanguage = button.dataset.language;

          if (selectedLanguage) {
            setLanguage(selectedLanguage);
          }
        });
      });

      const savedLanguage =
        localStorage.getItem("doppelpunked-language") || "de";

      setLanguage(savedLanguage);
    </script>

    <script is:inline>
      const revealElements = document.querySelectorAll(".reveal");

      const reducedMotion = window.matchMedia(
        "(prefers-reduced-motion: reduce)"
      ).matches;

      if (reducedMotion || !("IntersectionObserver" in window)) {
        revealElements.forEach((element) => {
          element.classList.add("is-visible");
        });
      } else {
        const observer = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                entry.target.classList.add("is-visible");
                observer.unobserve(entry.target);
              }
            });
          },
          {
            threshold: 0.12,
            rootMargin: "0px 0px -40px 0px",
          }
        );

        revealElements.forEach((element, index) => {
          element.style.setProperty(
            "--reveal-delay",
            `${Math.min(index * 70, 280)}ms`
          );

          observer.observe(element);
        });
      }
    </script>
  </body>
</html>

<style>
  :global(*) {
    box-sizing: border-box;
  }

  :global(html) {
    scroll-behavior: smooth;
  }

  :global(body) {
    margin: 0;
    overflow-x: hidden;
    background: #f5f6f7;
    color: #10243d;
    font-family:
      Inter,
      ui-sans-serif,
      system-ui,
      -apple-system,
      BlinkMacSystemFont,
      "Segoe UI",
      sans-serif;
    -webkit-font-smoothing: antialiased;
  }

  :global(a) {
    color: inherit;
  }

  .site-header {
    position: sticky;
    top: 0;
    z-index: 20;
    background: rgba(245, 246, 247, 0.88);
    border-bottom: 1px solid rgba(217, 224, 231, 0.9);
    backdrop-filter: blur(14px);
  }

  .header-inner,
  .hero-inner,
  .content-section,
  .contact-inner,
  .footer-inner {
    width: min(1120px, calc(100% - 40px));
    margin-inline: auto;
  }

  .header-inner {
    min-height: 76px;
    display: flex;
    align-items: center;
    gap: 32px;
  }

  .logo {
    margin-right: auto;
    font-size: 1.3rem;
    font-weight: 780;
    letter-spacing: -0.035em;
    text-decoration: none;
  }

  .desktop-nav {
    display: flex;
    gap: 26px;
  }

  .desktop-nav a {
    position: relative;
    color: #46586c;
    font-size: 0.95rem;
    font-weight: 650;
    text-decoration: none;
  }

  .desktop-nav a::after {
    content: "";
    position: absolute;
    right: 0;
    bottom: -7px;
    left: 0;
    height: 2px;
    background: linear-gradient(90deg, #174f82, #6c4aa3);
    transform: scaleX(0);
    transform-origin: right;
    transition: transform 180ms ease;
  }

  .desktop-nav a:hover {
    color: #124f85;
  }

  .desktop-nav a:hover::after {
    transform: scaleX(1);
    transform-origin: left;
  }

  .language-switch {
    display: flex;
    padding: 3px;
    border: 1px solid #cbd5df;
    border-radius: 9px;
    background: white;
  }

  .language-button {
    min-width: 42px;
    padding: 8px 10px;
    border: 0;
    border-radius: 6px;
    background: transparent;
    color: #536579;
    cursor: pointer;
    font: inherit;
    font-size: 0.84rem;
    font-weight: 750;
  }

  .language-button.active {
    background: #174f82;
    color: white;
  }

  .hero {
    position: relative;
    overflow: hidden;
    border-bottom: 1px solid #d9e0e7;
    background-color: #f5f6f7;
    background-image:
      linear-gradient(
        rgba(23, 79, 130, 0.055) 1px,
        transparent 1px
      ),
      linear-gradient(
        90deg,
        rgba(23, 79, 130, 0.055) 1px,
        transparent 1px
      );
    background-size: 48px 48px;
  }

  .hero::before,
  .hero::after {
    content: "";
    position: absolute;
    border-radius: 50%;
    filter: blur(10px);
    pointer-events: none;
  }

  .hero::before {
    width: 440px;
    height: 440px;
    top: -220px;
    right: -100px;
    background: radial-gradient(
      circle,
      rgba(106, 72, 164, 0.18),
      transparent 68%
    );
  }

  .hero::after {
    width: 360px;
    height: 360px;
    bottom: -220px;
    left: -120px;
    background: radial-gradient(
      circle,
      rgba(26, 111, 157, 0.18),
      transparent 68%
    );
  }

  .hero-inner {
    position: relative;
    z-index: 1;
    min-height: calc(100vh - 77px);
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding-block: 80px;
  }

  .eyebrow,
  .section-label {
    margin: 0 0 20px;
    color: #1e5d93;
    font-size: 0.78rem;
    font-weight: 800;
    letter-spacing: 0.17em;
    text-transform: uppercase;
  }

  h1,
  h2,
  h3,
  p {
    overflow-wrap: anywhere;
  }

  h1 {
    max-width: 900px;
    margin: 0;
    font-size: clamp(3rem, 6vw, 5.7rem);
    font-weight: 720;
    letter-spacing: -0.055em;
    line-height: 0.98;
  }

  .hero-text {
    max-width: 760px;
    margin: 32px 0 0;
    color: #536579;
    font-size: clamp(1.08rem, 1.7vw, 1.35rem);
    line-height: 1.65;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
    margin-top: 38px;
  }

  .button {
    display: inline-flex;
    min-height: 50px;
    align-items: center;
    justify-content: center;
    padding: 13px 21px;
    border: 1px solid #174f82;
    border-radius: 9px;
    font-size: 0.96rem;
    font-weight: 750;
    text-decoration: none;
    transition:
      transform 180ms ease,
      background 180ms ease,
      box-shadow 180ms ease;
  }

  .button:hover {
    transform: translateY(-3px);
  }

  .button-primary {
    background: #174f82;
    color: white;
    box-shadow: 0 10px 24px rgba(23, 79, 130, 0.16);
  }

  .button-primary:hover {
    background: #103e69;
    box-shadow: 0 15px 30px rgba(23, 79, 130, 0.24);
  }

  .button-secondary {
    background: rgba(255, 255, 255, 0.45);
    color: #174f82;
    backdrop-filter: blur(8px);
  }

  .content-section {
    padding-block: 100px;
    border-bottom: 1px solid #d9e0e7;
  }

  .section-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(300px, 0.8fr);
    gap: 80px;
    align-items: start;
  }

  h2 {
    max-width: 760px;
    margin: 0;
    font-size: clamp(2.2rem, 4vw, 4rem);
    font-weight: 700;
    letter-spacing: -0.045em;
    line-height: 1.05;
  }

  .section-copy {
    margin: 42px 0 0;
    color: #536579;
    font-size: 1.15rem;
    line-height: 1.75;
  }

  .section-grid .section-copy {
    margin-top: 40px;
  }

  .section-heading {
    margin-bottom: 42px;
  }

  .cards {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 20px;
    perspective: 1000px;
  }

  .focus-card {
    position: relative;
    min-height: 390px;
    display: flex;
    flex-direction: column;
    padding: 30px;
    overflow: hidden;
    border: 1px solid rgba(23, 79, 130, 0.16);
    border-radius: 18px;
    background:
      linear-gradient(
        145deg,
        rgba(255, 255, 255, 0.96),
        rgba(238, 244, 249, 0.88)
      );
    box-shadow:
      0 14px 40px rgba(16, 36, 61, 0.06),
      inset 0 1px 0 rgba(255, 255, 255, 0.9);
    backdrop-filter: blur(10px);
    transition:
      transform 220ms ease,
      box-shadow 220ms ease,
      border-color 220ms ease;
  }

  .focus-card::before {
    content: "";
    position: absolute;
    width: 190px;
    height: 190px;
    top: -100px;
    right: -90px;
    border-radius: 50%;
    background: radial-gradient(
      circle,
      rgba(92, 61, 163, 0.18),
      transparent 68%
    );
    transition: transform 350ms ease;
  }

  .focus-card::after {
    content: "";
    position: absolute;
    inset: 0;
    pointer-events: none;
    background:
      linear-gradient(
        115deg,
        transparent 25%,
        rgba(255, 255, 255, 0.55) 45%,
        transparent 65%
      );
    transform: translateX(-120%);
    transition: transform 650ms ease;
  }

  .focus-card:hover {
    transform: translateY(-8px) rotateX(1deg);
    border-color: rgba(23, 79, 130, 0.34);
    box-shadow:
      0 24px 55px rgba(16, 36, 61, 0.13),
      inset 0 1px 0 rgba(255, 255, 255, 0.95);
  }

  .focus-card:hover::before {
    transform: scale(1.25);
  }

  .focus-card:hover::after {
    transform: translateX(120%);
  }

  .card-top {
    position: relative;
    z-index: 1;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .number {
    color: #1e5d93;
    font-size: 0.82rem;
    font-weight: 800;
    letter-spacing: 0.12em;
  }

  .card-icon {
    display: grid;
    width: 42px;
    height: 42px;
    place-items: center;
    border: 1px solid rgba(23, 79, 130, 0.16);
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.72);
    color: #174f82;
    font-size: 1.2rem;
  }

  .brand-icon {
    font-size: 1.45rem;
