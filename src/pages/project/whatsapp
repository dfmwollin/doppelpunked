    <script>
      (() => {
        const body = document.body;
        const languageButtons = [...document.querySelectorAll("[data-set-language]")];
        const choiceButtons = [...document.querySelectorAll("[data-choice]")];
        const choiceResults = [...document.querySelectorAll("[data-result]")];
        const filterButtons = [...document.querySelectorAll("[data-filter]")];
        const tipCards = [...document.querySelectorAll("[data-category]")];
        const copyButton = document.getElementById("copyRules");
        const copyStatus = document.getElementById("copyStatus");
        const printButton = document.getElementById("printButton");

        function setLanguage(language) {
          const nextLanguage = language === "de" ? "de" : "en";
          body.dataset.language = nextLanguage;
          document.documentElement.lang = nextLanguage;
          languageButtons.forEach((button) => {
            button.setAttribute(
              "aria-pressed",
              String(button.dataset.setLanguage === nextLanguage),
            );
          });
          document.title =
            nextLanguage === "de"
              ? "WhatsApp Gruppen-Spickzettel"
              : "WhatsApp Group Cheat Sheet";
          copyStatus.textContent = "";
          try {
            localStorage.setItem("whatsapp-cheat-sheet-language", nextLanguage);
          } catch (_) {
            // The page still works when storage is unavailable.
          }
        }

        languageButtons.forEach((button) => {
          button.addEventListener("click", () => setLanguage(button.dataset.setLanguage));
        });

        choiceButtons.forEach((button) => {
          button.addEventListener("click", () => {
            const chosen = button.dataset.choice;
            choiceButtons.forEach((item) => {
              item.setAttribute("aria-pressed", String(item === button));
            });
            choiceResults.forEach((result) => {
              result.classList.toggle("active", result.dataset.result === chosen);
            });
          });
        });

        filterButtons.forEach((button) => {
          button.addEventListener("click", () => {
            const filter = button.dataset.filter;
            filterButtons.forEach((item) => {
              item.setAttribute("aria-pressed", String(item === button));
            });
            tipCards.forEach((card) => {
              card.hidden = filter !== "all" && card.dataset.category !== filter;
            });
          });
        });

        async function copyGroupNote() {
          const language = body.dataset.language;
          const text =
            language === "de"
              ? [
                  "Willkommen! Ein paar einfache Gruppenregeln:",
                  "• Direkt auf die gemeinte Nachricht antworten.",
                  "• Für einfache Bestätigungen Reaktionen nutzen.",
                  "• Privat antworten, wenn nur eine Person die Antwort braucht.",
                  "• @all nur für dringende Informationen an alle nutzen.",
                  "• Persönliche oder sensible Themen aus der Gruppe heraushalten.",
                  "• Aktuelle Termine und Links in der angehefteten Nachricht prüfen.",
                ].join("\n")
              : [
                  "Welcome! A few simple group habits:",
                  "• Reply directly to the message you mean.",
                  "• Use reactions for simple acknowledgements.",
                  "• Reply privately when only one person needs the answer.",
                  "• Use @all only for urgent group-wide updates.",
                  "• Keep personal or sensitive matters out of the group.",
                  "• Check the pinned message for current dates and links.",
                ].join("\n");

          try {
            await navigator.clipboard.writeText(text);
            copyStatus.textContent = language === "de" ? "Kopiert ✓" : "Copied ✓";
          } catch (_) {
            copyStatus.textContent =
              language === "de"
                ? "Bitte den Text oben manuell kopieren."
                : "Please copy the text above manually.";
          }
        }

        copyButton.addEventListener("click", copyGroupNote);
        printButton.addEventListener("click", () => window.print());

        let preferredLanguage = "en";
        try {
          const storedLanguage = localStorage.getItem("whatsapp-cheat-sheet-language");
          if (storedLanguage === "de" || storedLanguage === "en") {
            preferredLanguage = storedLanguage;
          } else if (navigator.language.toLowerCase().startsWith("de")) {
            preferredLanguage = "de";
          }
        } catch (_) {
          if (navigator.language.toLowerCase().startsWith("de")) {
            preferredLanguage = "de";
          }
        }
        setLanguage(preferredLanguage);
      })();
    </script>
