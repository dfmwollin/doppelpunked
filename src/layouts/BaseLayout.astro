---
import Header from "../components/Header.astro";import Footer from "../components/Footer.astro";import "../styles/global.css";
const {titleDe,titleEn,descriptionDe,descriptionEn}=Astro.props;
---
<!doctype html><html lang="de"><head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><meta name="description" content={descriptionDe}/><link rel="icon" type="image/svg+xml" href="/favicon.svg"/><link rel="alternate icon" href="/favicon.ico"/><title>{titleDe}</title><script is:inline>document.documentElement.classList.add('js');</script></head><body data-title-de={titleDe} data-title-en={titleEn} data-description-de={descriptionDe} data-description-en={descriptionEn}><Header/><main><slot/></main><Footer/><script is:inline>
const buttons=document.querySelectorAll('[data-language]'),translated=document.querySelectorAll('[data-de][data-en]'),mailLinks=document.querySelectorAll('.language-mail-link'),menu=document.querySelector('.menu-button'),nav=document.querySelector('#site-navigation'),meta=document.querySelector('meta[name="description"]');
function setLanguage(lang){document.documentElement.lang=lang;translated.forEach(el=>{const t=el.dataset[lang];if(t)el.textContent=t});mailLinks.forEach(link=>{const href=lang==='en'?link.dataset.mailEn:link.dataset.mailDe;if(href)link.href=href});buttons.forEach(b=>{const active=b.dataset.language===lang;b.classList.toggle('active',active);b.setAttribute('aria-pressed',String(active))});document.title=lang==='en'?document.body.dataset.titleEn:document.body.dataset.titleDe;const d=lang==='en'?document.body.dataset.descriptionEn:document.body.dataset.descriptionDe;if(meta&&d)meta.content=d;localStorage.setItem('doppelpunked-language',lang)}
buttons.forEach(b=>b.addEventListener('click',()=>setLanguage(b.dataset.language)));if(menu&&nav){menu.addEventListener('click',()=>{const open=nav.classList.toggle('open');menu.setAttribute('aria-expanded',String(open))});nav.querySelectorAll('a').forEach(a=>a.addEventListener('click',()=>nav.classList.remove('open')))}setLanguage(localStorage.getItem('doppelpunked-language')||'de');
const els=document.querySelectorAll('.reveal'),reduced=matchMedia('(prefers-reduced-motion: reduce)').matches;if(reduced||!('IntersectionObserver'in window)){els.forEach(e=>e.classList.add('is-visible'))}else{const o=new IntersectionObserver(es=>es.forEach(e=>{if(e.isIntersecting){e.target.classList.add('is-visible');o.unobserve(e.target)}}),{threshold:.12,rootMargin:'0px 0px -40px 0px'});els.forEach((e,i)=>{e.style.setProperty('--reveal-delay',`${Math.min(i*70,280)}ms`);o.observe(e)})}
</script></body></html>
