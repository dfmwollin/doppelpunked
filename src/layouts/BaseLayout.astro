---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import "../styles/global.css";

interface Props {
  titleDe: string;
  titleEn: string;
  descriptionDe: string;
  descriptionEn: string;
}

const {
  titleDe,
  titleEn,
  descriptionDe,
  descriptionEn,
} = Astro.props;
---

<!doctype html>
<html lang="de">
  <head>
    <meta charset="UTF-8" />

    <meta
      name="viewport"
      content="width=device-width, initial-scale=1"
    />

    <meta
      name="description"
      content={descriptionDe}
    />

    <link
      rel="icon"
      type="image/svg+xml"
      href="/favicon.svg"
    />

    <link
      rel="alternate icon"
      href="/favicon.ico"
    />

    <title>{titleDe}</title>

    <script is:inline>
      document.documentElement.classList.add("js");
    </script>
  </head>

  <body
    data-title-de={titleDe}
    data-title-en={titleEn}
    data-description-de={descriptionDe}
    data-description-en={descriptionEn}
  >
    <Header />

    <main>
      <slot />
    </main>

    <Footer />

    <!-- Desktop / mouse colon cursor -->
    <div
      class="colon-cursor"
      aria-hidden="true"
    >
      <span
        class="colon-dot colon-dot-primary"
      ></span>

      <span
        class="colon-dot colon-dot-trailing"
      ></span>
    </div>

    <!-- Mobile / touchscreen colon -->
    <div
      class="touch-colon"
      aria-hidden="true"
    >
      <span
        class="touch-dot touch-dot-one"
      ></span>

      <span
        class="touch-dot touch-dot-two"
      ></span>
    </div>

    <script is:inline>
      // ==================================
      // LANGUAGE
      // ==================================

      const languageButtons =
        document.querySelectorAll("[data-language]");

      const translatedElements =
        document.querySelectorAll("[data-de][data-en]");

      const translatedImages =
        document.querySelectorAll(
          "[data-alt-de][data-alt-en]"
        );

      const languageMailLinks =
        document.querySelectorAll(
          ".language-mail-link"
        );

      const metaDescription =
        document.querySelector(
          'meta[name="description"]'
        );

      function setLanguage(language) {
        document.documentElement.lang = language;

        translatedElements.forEach((element) => {
          const translatedText =
            element.dataset[language];

          if (translatedText) {
            element.textContent = translatedText;
          }
        });

        translatedImages.forEach((image) => {
          const translatedAlt =
            language === "en"
              ? image.dataset.altEn
              : image.dataset.altDe;

          if (translatedAlt) {
            image.setAttribute(
              "alt",
              translatedAlt
            );
          }
        });

        languageMailLinks.forEach((link) => {
          const selectedMailLink =
            language === "en"
              ? link.dataset.mailEn
              : link.dataset.mailDe;

          if (selectedMailLink) {
            link.setAttribute(
              "href",
              selectedMailLink
            );
          }
        });

        languageButtons.forEach((button) => {
          const isActive =
            button.dataset.language === language;

          button.classList.toggle(
            "active",
            isActive
          );

          button.setAttribute(
            "aria-pressed",
            String(isActive)
          );
        });

        const pageTitle =
          language === "en"
            ? document.body.dataset.titleEn
            : document.body.dataset.titleDe;

        if (pageTitle) {
          document.title = pageTitle;
        }

        const pageDescription =
          language === "en"
            ? document.body.dataset.descriptionEn
            : document.body.dataset.descriptionDe;

        if (
          metaDescription &&
          pageDescription
        ) {
          metaDescription.setAttribute(
            "content",
            pageDescription
          );
        }

        localStorage.setItem(
          "doppelpunked-language",
          language
        );
      }

      languageButtons.forEach((button) => {
        button.addEventListener(
          "click",
          () => {
            const selectedLanguage =
              button.dataset.language;

            if (selectedLanguage) {
              setLanguage(
                selectedLanguage
              );
            }
          }
        );
      });

      const savedLanguage =
        localStorage.getItem(
          "doppelpunked-language"
        ) || "de";

      setLanguage(savedLanguage);


      // ==================================
      // REVEAL ANIMATIONS
      // ==================================

      const revealElements =
        document.querySelectorAll(".reveal");

      const reducedMotion =
        window.matchMedia(
          "(prefers-reduced-motion: reduce)"
        ).matches;

      if (
        reducedMotion ||
        !("IntersectionObserver" in window)
      ) {
        revealElements.forEach((element) => {
          element.classList.add(
            "is-visible"
          );
        });
      } else {
        const observer =
          new IntersectionObserver(
            (entries) => {
              entries.forEach((entry) => {
                if (
                  entry.isIntersecting
                ) {
                  entry.target.classList.add(
                    "is-visible"
                  );

                  observer.unobserve(
                    entry.target
                  );
                }
              });
            },
            {
              threshold: 0.12,
              rootMargin:
                "0px 0px -40px 0px",
            }
          );

        revealElements.forEach(
          (element, index) => {
            element.style.setProperty(
              "--reveal-delay",
              `${Math.min(
                index * 70,
                280
              )}ms`
            );

            observer.observe(element);
          }
        );
      }


      // ==================================
      // DESKTOP COLON CURSOR
      // ==================================

      const finePointer =
        window.matchMedia(
          "(hover: hover) and (pointer: fine)"
        );

      if (
        finePointer.matches &&
        !reducedMotion
      ) {
        const colonCursor =
          document.querySelector(
            ".colon-cursor"
          );

        const primaryDot =
          document.querySelector(
            ".colon-dot-primary"
          );

        const trailingDot =
          document.querySelector(
            ".colon-dot-trailing"
          );

        if (
          colonCursor &&
          primaryDot &&
          trailingDot
        ) {
          document.documentElement.classList.add(
            "has-colon-cursor"
          );

          let mouseX =
            window.innerWidth / 2;

          let mouseY =
            window.innerHeight / 2;

          let primaryX = mouseX;
          let primaryY = mouseY;

          let trailingX = mouseX;
          let trailingY =
            mouseY + 20;

          let lastMovement =
            performance.now();

          let smoothedActivity = 0;

          let breathingPhase = 0;

          let lastFrameTime =
            performance.now();

          const gap = 20;


          window.addEventListener(
            "mousemove",
            (event) => {
              mouseX = event.clientX;
              mouseY = event.clientY;

              lastMovement =
                performance.now();

              colonCursor.classList.add(
                "is-visible"
              );
            }
          );

          document.addEventListener(
            "mouseleave",
            () => {
              colonCursor.classList.remove(
                "is-visible"
              );
            }
          );

          document.addEventListener(
            "mouseenter",
            () => {
              colonCursor.classList.add(
                "is-visible"
              );
            }
          );


          function animateColonCursor(time) {
            const previousPrimaryX =
              primaryX;

            const previousPrimaryY =
              primaryY;

            primaryX +=
              (mouseX - primaryX) *
              0.32;

            primaryY +=
              (mouseY - primaryY) *
              0.32;

            const dx =
              primaryX -
              previousPrimaryX;

            const dy =
              primaryY -
              previousPrimaryY;

            const speed =
              Math.sqrt(
                dx * dx +
                dy * dy
              );

            const activity =
              Math.min(
                speed / 18,
                1
              );

            smoothedActivity +=
              (
                activity -
                smoothedActivity
              ) * 0.04;

            const isIdle =
              time -
                lastMovement >
              140;

            const targetTrailingX =
              primaryX;

            const targetTrailingY =
              isIdle
                ? primaryY + gap
                : primaryY + 7;

            trailingX +=
              (
                targetTrailingX -
                trailingX
              ) * 0.11;

            trailingY +=
              (
                targetTrailingY -
                trailingY
              ) * 0.11;

            const breathingPeriod =
              2500 -
              smoothedActivity *
                1500;

            const delta =
              Math.min(
                time -
                  lastFrameTime,
                50
              );

            breathingPhase +=
              (
                delta /
                breathingPeriod
              ) *
              Math.PI *
              2;

            lastFrameTime = time;

            const breath =
              1 +
              Math.sin(
                breathingPhase
              ) *
                0.06;

            const trailingBreath =
              1 +
              Math.sin(
                breathingPhase -
                  0.22
              ) *
                0.045;

            primaryDot.style.transform =
              `translate3d(
                ${primaryX}px,
                ${primaryY}px,
                0
              )
              scale(${breath})`;

            trailingDot.style.transform =
              `translate3d(
                ${trailingX}px,
                ${trailingY}px,
                0
              )
              scale(${trailingBreath})`;

            requestAnimationFrame(
              animateColonCursor
            );
          }

          requestAnimationFrame(
            animateColonCursor
          );
        }
      }


      // ==================================
// MOBILE / TOUCHSCREEN COLON
// ==================================

if (!reducedMotion) {
  const touchColon =
    document.querySelector(".touch-colon");

  const touchDotOne =
    document.querySelector(".touch-dot-one");

  const touchDotTwo =
    document.querySelector(".touch-dot-two");

  if (
    touchColon &&
    touchDotOne &&
    touchDotTwo
  ) {
    let touchX = 0;
    let touchY = 0;

    let touching = false;

    let tunnelPhase = 0;

    let lastTouchFrame =
      performance.now();


    function updateTouchPosition(event) {

      // Only react to an actual finger.
      // Mouse interactions are handled by
      // the desktop cursor.

      if (event.pointerType !== "touch") {
        return;
      }

      touchX = event.clientX;

      /*
        Move the animation slightly above
        the actual touch point so the
        finger doesn't completely cover it.
      */

      touchY =
        event.clientY - 18;

      touching = true;

      touchColon.classList.add(
        "is-visible"
      );
    }


    window.addEventListener(
      "pointerdown",
      (event) => {

        if (
          event.pointerType !== "touch"
        ) {
          return;
        }

        tunnelPhase =
          -Math.PI / 2;

        updateTouchPosition(event);
      },
      {
        passive: true,
      }
    );


    window.addEventListener(
      "pointermove",
      (event) => {

        if (
          event.pointerType !== "touch"
        ) {
          return;
        }

        updateTouchPosition(event);
      },
      {
        passive: true,
      }
    );


    window.addEventListener(
      "pointerup",
      (event) => {

        if (
          event.pointerType !== "touch"
        ) {
          return;
        }

        touching = false;

        touchColon.classList.remove(
          "is-visible"
        );
      },
      {
        passive: true,
      }
    );


    window.addEventListener(
      "pointercancel",
      (event) => {

        if (
          event.pointerType !== "touch"
        ) {
          return;
        }

        touching = false;

        touchColon.classList.remove(
          "is-visible"
        );
      },
      {
        passive: true,
      }
    );


    function animateTouchColon(time) {

      const delta =
        Math.min(
          time - lastTouchFrame,
          40
        );

      lastTouchFrame = time;


      if (touching) {

        /*
          Full left → right → left cycle:
          approximately 1.8 seconds.
        */

        tunnelPhase +=
          (
            delta / 1800
          ) *
          Math.PI *
          2;


        /*
          -1 = left
           0 = underneath finger
          +1 = right
        */

        const travel =
          Math.sin(
            tunnelPhase
          );


        /*
          Horizontal travel distance.
        */

        const maxOffset = 46;

        const centerOffset =
          travel *
          maxOffset;


        /*
          Shrink while entering the finger.
        */

        const distance =
          Math.abs(
            travel
          );


        /*
          Goes from nearly invisible/small
          under the finger to normal size
          beside it.
        */

        const tunnelScale =
          0.08 +
          distance *
          0.92;


        /*
          Fade while underneath.
        */

        const tunnelOpacity =
          0.12 +
          distance *
          0.88;


        /*
          Vertical colon spacing.
        */

        const verticalGap = 7;


        const dotOneX =
          touchX +
          centerOffset;

        const dotOneY =
          touchY -
          verticalGap;


        const dotTwoX =
          touchX +
          centerOffset;

        const dotTwoY =
          touchY +
          verticalGap;


        touchDotOne.style.transform =
          `translate3d(
            ${dotOneX}px,
            ${dotOneY}px,
            0
          )
          scale(${tunnelScale})`;


        touchDotTwo.style.transform =
          `translate3d(
            ${dotTwoX}px,
            ${dotTwoY}px,
            0
          )
          scale(${tunnelScale})`;


        touchDotOne.style.opacity =
          tunnelOpacity;


        touchDotTwo.style.opacity =
          tunnelOpacity * 0.72;
      }


      requestAnimationFrame(
        animateTouchColon
      );
    }


    requestAnimationFrame(
      animateTouchColon
    );
  }
}
    </script>
  </body>
</html>