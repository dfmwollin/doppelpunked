---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import "../styles/global.css";

interface Props {
  titleDe: string;
  titleEn: string;
  descriptionDe: string;
  descriptionEn: string;
}

const {
  titleDe,
  titleEn,
  descriptionDe,
  descriptionEn,
} = Astro.props;
---

<!doctype html>
<html lang="de">
  <head>
    <meta charset="UTF-8" />

    <meta
      name="viewport"
      content="width=device-width, initial-scale=1"
    />

    <meta
      name="description"
      content={descriptionDe}
    />

<link rel="icon" href="/favicon.ico" sizes="any" />
<link
  rel="icon"
  type="image/png"
  sizes="32x32"
  href="/favicon-32x32.png"
/>
<link
  rel="icon"
  type="image/png"
  sizes="16x16"
  href="/favicon-16x16.png"
/>
<link
  rel="apple-touch-icon"
  sizes="180x180"
  href="/apple-touch-icon.png"
/>
<link rel="manifest" href="/site.webmanifest" />

    <title>{titleDe}</title>

    <script is:inline>
      document.documentElement.classList.add("js");
    </script>
  </head>

  <body
    data-title-de={titleDe}
    data-title-en={titleEn}
    data-description-de={descriptionDe}
    data-description-en={descriptionEn}
  >
    <Header />

    <main>
      <slot />
    </main>

    <Footer />

    <!-- Desktop / mouse colon cursor -->
    <div
      class="colon-cursor"
      aria-hidden="true"
    >
      <span
        class="colon-dot colon-dot-primary"
      ></span>

      <span
        class="colon-dot colon-dot-trailing"
      ></span>
    </div>

    <!-- Mobile / touchscreen colon -->
    <div
      class="touch-colon"
      aria-hidden="true"
    >
      <span
        class="touch-dot touch-dot-one"
      ></span>

      <span
        class="touch-dot touch-dot-two"
      ></span>
    </div>


    <script is:inline>
      // ==================================
      // LANGUAGE
      // ==================================

      const languageButtons =
        document.querySelectorAll(
          "[data-language]"
        );

      const translatedElements =
        document.querySelectorAll(
          "[data-de][data-en]"
        );

      const translatedImages =
        document.querySelectorAll(
          "[data-alt-de][data-alt-en]"
        );

      const languageMailLinks =
        document.querySelectorAll(
          ".language-mail-link"
        );

      const metaDescription =
        document.querySelector(
          'meta[name="description"]'
        );


      function setLanguage(language) {
        document.documentElement.lang =
          language;

        translatedElements.forEach(
          (element) => {
            const translatedText =
              element.dataset[language];

            if (translatedText) {
              element.textContent =
                translatedText;
            }
          }
        );

        translatedImages.forEach(
          (image) => {
            const translatedAlt =
              language === "en"
                ? image.dataset.altEn
                : image.dataset.altDe;

            if (translatedAlt) {
              image.setAttribute(
                "alt",
                translatedAlt
              );
            }
          }
        );

        languageMailLinks.forEach(
          (link) => {
            const selectedMailLink =
              language === "en"
                ? link.dataset.mailEn
                : link.dataset.mailDe;

            if (selectedMailLink) {
              link.setAttribute(
                "href",
                selectedMailLink
              );
            }
          }
        );

        languageButtons.forEach(
          (button) => {
            const isActive =
              button.dataset.language ===
              language;

            button.classList.toggle(
              "active",
              isActive
            );

            button.setAttribute(
              "aria-pressed",
              String(isActive)
            );
          }
        );

        const pageTitle =
          language === "en"
            ? document.body.dataset.titleEn
            : document.body.dataset.titleDe;

        if (pageTitle) {
          document.title = pageTitle;
        }

        const pageDescription =
          language === "en"
            ? document.body.dataset
                .descriptionEn
            : document.body.dataset
                .descriptionDe;

        if (
          metaDescription &&
          pageDescription
        ) {
          metaDescription.setAttribute(
            "content",
            pageDescription
          );
        }

        localStorage.setItem(
          "doppelpunked-language",
          language
        );
      }


      languageButtons.forEach(
        (button) => {
          button.addEventListener(
            "click",
            () => {
              const selectedLanguage =
                button.dataset.language;

              if (selectedLanguage) {
                setLanguage(
                  selectedLanguage
                );
              }
            }
          );
        }
      );


      const savedLanguage =
        localStorage.getItem(
          "doppelpunked-language"
        ) || "de";

      setLanguage(savedLanguage);



      // ==================================
      // BLOCK TEXT SELECTION / LONG PRESS
      // ==================================

      function isEditableElement(target) {
        if (
          !(target instanceof Element)
        ) {
          return false;
        }

        return Boolean(
          target.closest(
            `
              input,
              textarea,
              select,
              [contenteditable="true"]
            `
          )
        );
      }


      /*
        Prevent normal browser text
        selection.

        Form fields remain selectable.
      */

      document.addEventListener(
        "selectstart",
        (event) => {
          if (
            !isEditableElement(
              event.target
            )
          ) {
            event.preventDefault();
          }
        }
      );


      /*
        iPhone/iPad can display the
        native long-press callout even
        when user-select:none is set.

        Prevent it outside editable
        elements.
      */

      document.addEventListener(
        "contextmenu",
        (event) => {
          if (
            !isEditableElement(
              event.target
            )
          ) {
            event.preventDefault();
          }
        }
      );


      /*
        Prevent dragging text, links
        and images into another app
        or browser location.
      */

      document.addEventListener(
        "dragstart",
        (event) => {
          if (
            !isEditableElement(
              event.target
            )
          ) {
            event.preventDefault();
          }
        }
      );


      /*
        Safari sometimes retains an
        existing selection after a
        long touch.

        Clear accidental selections
        when a finger touches the page.
      */

      document.addEventListener(
        "touchstart",
        (event) => {
          if (
            isEditableElement(
              event.target
            )
          ) {
            return;
          }

          const selection =
            window.getSelection();

          if (
            selection &&
            selection.rangeCount > 0
          ) {
            selection.removeAllRanges();
          }
        },
        {
          passive: true,
        }
      );


      /*
        Clear any selection that iOS
        manages to create despite the
        CSS/selectstart protection.
      */

      document.addEventListener(
        "selectionchange",
        () => {
          const activeElement =
            document.activeElement;

          if (
            isEditableElement(
              activeElement
            )
          ) {
            return;
          }

          const selection =
            window.getSelection();

          if (
            selection &&
            !selection.isCollapsed
          ) {
            selection.removeAllRanges();
          }
        }
      );



      // ==================================
      // REVEAL ANIMATIONS
      // ==================================

      const revealElements =
        document.querySelectorAll(
          ".reveal"
        );

      const reducedMotion =
        window.matchMedia(
          "(prefers-reduced-motion: reduce)"
        ).matches;


      if (
        reducedMotion ||
        !(
          "IntersectionObserver"
          in window
        )
      ) {
        revealElements.forEach(
          (element) => {
            element.classList.add(
              "is-visible"
            );
          }
        );
      } else {
        const observer =
          new IntersectionObserver(
            (entries) => {
              entries.forEach(
                (entry) => {
                  if (
                    entry.isIntersecting
                  ) {
                    entry.target
                      .classList.add(
                        "is-visible"
                      );

                    observer.unobserve(
                      entry.target
                    );
                  }
                }
              );
            },
            {
              threshold: 0.12,
              rootMargin:
                "0px 0px -40px 0px",
            }
          );


        revealElements.forEach(
          (element, index) => {
            element.style.setProperty(
              "--reveal-delay",
              `${Math.min(
                index * 70,
                280
              )}ms`
            );

            observer.observe(
              element
            );
          }
        );
      }



      // ==================================
      // DESKTOP COLON CURSOR
      // ==================================

      const finePointer =
        window.matchMedia(
          "(hover: hover) and (pointer: fine)"
        );


      if (
        finePointer.matches &&
        !reducedMotion
      ) {
        const colonCursor =
          document.querySelector(
            ".colon-cursor"
          );

        const primaryDot =
          document.querySelector(
            ".colon-dot-primary"
          );

        const trailingDot =
          document.querySelector(
            ".colon-dot-trailing"
          );


        if (
          colonCursor &&
          primaryDot &&
          trailingDot
        ) {
          document.documentElement
            .classList.add(
              "has-colon-cursor"
            );


          let mouseX =
            window.innerWidth / 2;

          let mouseY =
            window.innerHeight / 2;

          let primaryX = mouseX;
          let primaryY = mouseY;

          let trailingX = mouseX;

          let trailingY =
            mouseY + 20;

          let lastMovement =
            performance.now();

          let smoothedActivity = 0;

          let breathingPhase = 0;

          let lastFrameTime =
            performance.now();

          const gap = 20;


          window.addEventListener(
            "mousemove",
            (event) => {
              mouseX =
                event.clientX;

              mouseY =
                event.clientY;

              lastMovement =
                performance.now();

              colonCursor.classList.add(
                "is-visible"
              );
            }
          );


          document.addEventListener(
            "mouseleave",
            () => {
              colonCursor.classList.remove(
                "is-visible"
              );
            }
          );


          document.addEventListener(
            "mouseenter",
            () => {
              colonCursor.classList.add(
                "is-visible"
              );
            }
          );


          function animateColonCursor(
            time
          ) {
            const previousPrimaryX =
              primaryX;

            const previousPrimaryY =
              primaryY;


            primaryX +=
              (
                mouseX -
                primaryX
              ) * 0.32;

            primaryY +=
              (
                mouseY -
                primaryY
              ) * 0.32;


            const dx =
              primaryX -
              previousPrimaryX;

            const dy =
              primaryY -
              previousPrimaryY;


            const speed =
              Math.sqrt(
                dx * dx +
                dy * dy
              );


            const activity =
              Math.min(
                speed / 18,
                1
              );


            smoothedActivity +=
              (
                activity -
                smoothedActivity
              ) * 0.04;


            const isIdle =
              time -
                lastMovement >
              140;


            const targetTrailingX =
              primaryX;


            const targetTrailingY =
              isIdle
                ? primaryY + gap
                : primaryY + 7;


            trailingX +=
              (
                targetTrailingX -
                trailingX
              ) * 0.11;


            trailingY +=
              (
                targetTrailingY -
                trailingY
              ) * 0.11;


            const breathingPeriod =
              2500 -
              smoothedActivity *
                1500;


            const delta =
              Math.min(
                time -
                  lastFrameTime,
                50
              );


            breathingPhase +=
              (
                delta /
                breathingPeriod
              ) *
              Math.PI *
              2;


            lastFrameTime =
              time;


            const breath =
              1 +
              Math.sin(
                breathingPhase
              ) *
                0.06;


            const trailingBreath =
              1 +
              Math.sin(
                breathingPhase -
                  0.22
              ) *
                0.045;


            primaryDot.style.transform =
              `translate3d(
                ${primaryX}px,
                ${primaryY}px,
                0
              )
              scale(${breath})`;


            trailingDot.style.transform =
              `translate3d(
                ${trailingX}px,
                ${trailingY}px,
                0
              )
              scale(${trailingBreath})`;


            requestAnimationFrame(
              animateColonCursor
            );
          }


          requestAnimationFrame(
            animateColonCursor
          );
        }
      }



      // ==================================
      // MOBILE / TOUCHSCREEN COLON
      // ==================================

      if (!reducedMotion) {
        const touchColon =
          document.querySelector(
            ".touch-colon"
          );

        const touchDotOne =
          document.querySelector(
            ".touch-dot-one"
          );

        const touchDotTwo =
          document.querySelector(
            ".touch-dot-two"
          );


        if (
          touchColon &&
          touchDotOne &&
          touchDotTwo
        ) {
          let touchX = 0;
          let touchY = 0;

          let touching = false;

          let cycle = 0;

          let lastTouchFrame =
            performance.now();


          const sideOffset = 70;

          const verticalGap = 11;

          const cycleDuration = 2600;


          function clamp(
            value,
            min,
            max
          ) {
            return Math.min(
              Math.max(
                value,
                min
              ),
              max
            );
          }


          function smoothstep(value) {
            const t =
              clamp(
                value,
                0,
                1
              );

            return (
              t *
              t *
              (3 - 2 * t)
            );
          }


          function updateTouchPosition(
            event
          ) {
            if (
              event.pointerType !==
              "touch"
            ) {
              return;
            }


            touchX =
              event.clientX;


            /*
              Slightly above the actual
              fingertip so the dots
              remain visible.
            */

            touchY =
              event.clientY - 20;


            touching = true;


            touchColon.classList.add(
              "is-visible"
            );
          }


          window.addEventListener(
            "pointerdown",
            (event) => {
              if (
                event.pointerType !==
                "touch"
              ) {
                return;
              }


              /*
                Begin with both dots
                on the left.
              */

              cycle = 0;


              updateTouchPosition(
                event
              );
            },
            {
              passive: true,
            }
          );


          window.addEventListener(
            "pointermove",
            (event) => {
              if (
                event.pointerType !==
                "touch"
              ) {
                return;
              }


              updateTouchPosition(
                event
              );
            },
            {
              passive: true,
            }
          );


          window.addEventListener(
            "pointerup",
            (event) => {
              if (
                event.pointerType !==
                "touch"
              ) {
                return;
              }


              touching = false;


              touchColon.classList.remove(
                "is-visible"
              );
            },
            {
              passive: true,
            }
          );


          window.addEventListener(
            "pointercancel",
            (event) => {
              if (
                event.pointerType !==
                "touch"
              ) {
                return;
              }


              touching = false;


              touchColon.classList.remove(
                "is-visible"
              );
            },
            {
              passive: true,
            }
          );


          function getDotState(
            progress,
            start,
            end,
            fromSide,
            toSide
          ) {
            /*
              Dot hasn't started yet.
            */

            if (
              progress <= start
            ) {
              return {
                x:
                  fromSide *
                  sideOffset,

                scale: 1,

                opacity: 1,
              };
            }


            /*
              Dot has reached the
              opposite side.
            */

            if (
              progress >= end
            ) {
              return {
                x:
                  toSide *
                  sideOffset,

                scale: 1,

                opacity: 1,
              };
            }


            const localProgress =
              (
                progress -
                start
              ) /
              (
                end -
                start
              );


            const eased =
              smoothstep(
                localProgress
              );


            /*
              Independent horizontal
              movement.
            */

            const x =
              (
                fromSide *
                sideOffset
              ) +
              (
                (
                  toSide -
                  fromSide
                ) *
                sideOffset *
                eased
              );


            /*
              Shrink as this individual
              dot passes underneath the
              finger, then grow again.
            */

            const centerDistance =
              Math.abs(
                eased * 2 - 1
              );


            const scale =
              0.12 +
              centerDistance *
                0.88;


            const opacity =
              0.22 +
              centerDistance *
                0.78;


            return {
              x,
              scale,
              opacity,
            };
          }


          function animateTouchColon(
            time
          ) {
            const delta =
              Math.min(
                time -
                  lastTouchFrame,
                40
              );


            lastTouchFrame =
              time;


            if (touching) {
              cycle +=
                delta /
                cycleDuration;


              cycle =
                cycle % 1;


              /*
                First half:
                left -> right

                Second half:
                right -> left
              */

              const goingRight =
                cycle < 0.5;


              const halfProgress =
                goingRight
                  ? cycle * 2
                  : (
                      cycle -
                      0.5
                    ) * 2;


              const fromSide =
                goingRight
                  ? -1
                  : 1;


              const toSide =
                goingRight
                  ? 1
                  : -1;


              /*
                First dot tunnels
                through first.

                Second dot follows.
              */

              const dotOneState =
                getDotState(
                  halfProgress,
                  0.10,
                  0.60,
                  fromSide,
                  toSide
                );


              const dotTwoState =
                getDotState(
                  halfProgress,
                  0.40,
                  0.90,
                  fromSide,
                  toSide
                );


              const dotOneX =
                touchX +
                dotOneState.x;


              const dotOneY =
                touchY -
                verticalGap;


              const dotTwoX =
                touchX +
                dotTwoState.x;


              const dotTwoY =
                touchY +
                verticalGap;


              touchDotOne.style.transform =
                `translate3d(
                  ${dotOneX}px,
                  ${dotOneY}px,
                  0
                )
                scale(
                  ${dotOneState.scale}
                )`;


              touchDotTwo.style.transform =
                `translate3d(
                  ${dotTwoX}px,
                  ${dotTwoY}px,
                  0
                )
                scale(
                  ${dotTwoState.scale}
                )`;


              touchDotOne.style.opacity =
                dotOneState.opacity;


              touchDotTwo.style.opacity =
                dotTwoState.opacity;
            }


            requestAnimationFrame(
              animateTouchColon
            );
          }


          requestAnimationFrame(
            animateTouchColon
          );
        }
      }
    </script>
  </body>
</html>
