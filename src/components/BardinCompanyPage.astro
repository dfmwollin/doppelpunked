---
import { companies } from "../data/bardinCompanies.js";

const { company } = Astro.props;
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex, nofollow" />
    <meta
      name="description"
      content={`Bardin Germany GTM research experiment for ${company.name}.`}
    />
    <title>{company.name} — Bardin × Germany</title>

    <style>
      :root {
        --bg: #f5f6f3;
        --card: #ffffff;
        --text: #10110f;
        --muted: #666b62;
        --border: #dde2d8;
        --green: #b7ff2a;
        --green-soft: #efffd0;
        --green-dark: #4d6908;
        --dark: #10110f;
      }

      * { box-sizing: border-box; }

      html { scroll-behavior: smooth; }

      body {
        margin: 0;
        font-family: Inter, ui-sans-serif, system-ui, -apple-system,
          BlinkMacSystemFont, "Segoe UI", sans-serif;
        background: var(--bg);
        color: var(--text);
        line-height: 1.55;
      }

      a { color: inherit; }

      main {
        width: min(1050px, calc(100% - 28px));
        margin: 0 auto;
        padding: 22px 0 70px;
      }

      .switcher {
        display: flex;
        gap: 7px;
        flex-wrap: wrap;
        margin-bottom: 12px;
      }

      .switcher a {
        padding: 8px 11px;
        border: 1px solid var(--border);
        border-radius: 999px;
        background: var(--card);
        text-decoration: none;
        font-size: 12px;
        font-weight: 750;
      }

      .switcher a:hover,
      .switcher a.active {
        background: var(--green);
        border-color: var(--green);
        color: var(--dark);
      }

      .hero {
        position: relative;
        overflow: hidden;
        padding: 34px;
        border-radius: 24px;
        background: var(--dark);
        color: white;
      }

      .hero::after {
        content: "";
        position: absolute;
        width: 260px;
        height: 260px;
        right: -100px;
        top: -100px;
        border-radius: 50%;
        background: var(--green);
        opacity: 0.15;
      }

      .hero-content {
        position: relative;
        z-index: 1;
        display: grid;
        grid-template-columns: minmax(0, 1fr) 150px;
        gap: 34px;
        align-items: center;
      }

      .hero-text { min-width: 0; }

      .eyebrow {
        display: inline-block;
        margin-bottom: 16px;
        padding: 6px 10px;
        border-radius: 999px;
        background: var(--green);
        color: var(--dark);
        font-size: 12px;
        font-weight: 800;
        text-transform: uppercase;
        letter-spacing: 0.045em;
      }

      h1 {
        margin: 0;
        font-size: clamp(2.3rem, 6vw, 4.4rem);
        line-height: 1.02;
        letter-spacing: -0.025em;
        font-weight: 800;
      }

      .company-name {
        display: block;
        margin-top: 14px;
        color: var(--green);
        font-size: clamp(1.3rem, 3vw, 2rem);
        line-height: 1.18;
        letter-spacing: 0.005em;
        font-weight: 750;
      }

      .hero-copy {
        max-width: 740px;
        margin: 20px 0 0;
        color: #d5d9d0;
      }

      .meta-row {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
        margin-top: 22px;
      }

      .meta-pill {
        padding: 7px 11px;
        border: 1px solid #30342e;
        border-radius: 999px;
        background: #181a17;
        font-size: 13px;
      }

      .logo-link {
        display: block;
        width: fit-content;
        text-decoration: none;
        border-radius: 24px;
      }

      .logo-link .logo-wrap {
        transition: transform 0.15s ease, border-color 0.15s ease;
      }

      .logo-link:hover .logo-wrap {
        transform: translateY(-2px);
        border-color: var(--green);
      }

      .logo-link:focus-visible {
        outline: 3px solid var(--green);
        outline-offset: 4px;
      }

      .logo-wrap {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 150px;
        height: 150px;
        padding: 18px;
        border-radius: 22px;
        background: white;
        color: var(--dark);
      }

      .company-logo {
        display: block;
        width: 100%;
        height: 100%;
        object-fit: contain;
      }

      .logo-placeholder {
        width: 100%;
        height: 100%;
        display: grid;
        place-items: center;
        text-align: center;
        border: 2px dashed #c8ccc4;
        border-radius: 12px;
        font-weight: 850;
        font-size: 1.2rem;
        letter-spacing: 0.02em;
      }

      .decision-strip {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 1px;
        overflow: hidden;
        margin-top: 14px;
        border: 1px solid var(--border);
        border-radius: 18px;
        background: var(--border);
      }

      .decision-item {
        padding: 18px;
        background: var(--card);
      }

      .decision-label {
        color: var(--muted);
        font-size: 12px;
        text-transform: uppercase;
        letter-spacing: 0.05em;
      }

      .decision-value {
        display: block;
        margin-top: 4px;
        font-size: 1.45rem;
        font-weight: 800;
        letter-spacing: -0.01em;
      }

      .decision-value.green { color: var(--green-dark); }

      .main-insight {
        margin-top: 18px;
        padding: 22px;
        border: 1px solid var(--border);
        border-left: 5px solid var(--green);
        border-radius: 16px;
        background: var(--card);
      }

      .main-insight strong {
        display: block;
        margin-bottom: 6px;
        font-size: 0.82rem;
        text-transform: uppercase;
        letter-spacing: 0.06em;
        color: var(--green-dark);
      }

      .main-insight p {
        margin: 0;
        font-size: 1.08rem;
      }

      .quick-nav {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
        margin-top: 18px;
      }

      .quick-nav button {
        appearance: none;
        border: 1px solid var(--border);
        border-radius: 999px;
        padding: 9px 13px;
        background: var(--card);
        color: var(--text);
        font: inherit;
        font-size: 13px;
        font-weight: 700;
        cursor: pointer;
      }

      .quick-nav button:hover {
        border-color: var(--green-dark);
        background: var(--green-soft);
      }

      .modules {
        margin-top: 30px;
        display: grid;
        gap: 12px;
      }

      details.module {
        overflow: hidden;
        border: 1px solid var(--border);
        border-radius: 18px;
        background: var(--card);
      }

      details.module[open] { border-color: #c8d6ae; }

      summary {
        list-style: none;
        cursor: pointer;
      }

      summary::-webkit-details-marker { display: none; }

      .module-summary {
        display: grid;
        grid-template-columns: 46px 1fr auto;
        gap: 14px;
        align-items: center;
        padding: 18px 20px;
      }

      .module-number {
        display: grid;
        place-items: center;
        width: 40px;
        height: 40px;
        border-radius: 12px;
        background: var(--green-soft);
        color: var(--green-dark);
        font-size: 13px;
        font-weight: 900;
      }

      .module-title { min-width: 0; }

      .module-title strong {
        display: block;
        font-size: 1.02rem;
        letter-spacing: -0.005em;
      }

      .module-title span {
        display: block;
        margin-top: 2px;
        color: var(--muted);
        font-size: 0.87rem;
      }

      .chevron {
        display: inline-block;
        color: var(--muted);
        font-size: 1.4rem;
        transition: transform 0.2s ease;
      }

      details[open] > summary .chevron { transform: rotate(45deg); }

      .module-content { padding: 0 20px 22px 80px; }

      .pressure-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 12px;
      }

      .pressure-card {
        padding: 16px;
        border-top: 4px solid var(--green);
        border-radius: 14px;
        background: #f8faf5;
      }

      .pressure-card span {
        display: block;
        color: var(--muted);
        font-size: 12px;
      }

      .pressure-card strong {
        display: block;
        margin: 4px 0 7px;
        font-size: 1.25rem;
      }

      .pressure-card p {
        margin: 0;
        color: var(--muted);
        font-size: 0.88rem;
      }

      .signals-list {
        display: grid;
        gap: 8px;
      }

      details.signal {
        border: 1px solid var(--border);
        border-radius: 13px;
        background: #fafbf9;
      }

      .signal-summary {
        display: grid;
        grid-template-columns: 95px 1fr auto;
        gap: 12px;
        align-items: center;
        padding: 13px 14px;
      }

      .signal-date {
        color: var(--muted);
        font-size: 12px;
      }

      .signal-title-wrap { min-width: 0; }

      .signal-title-wrap strong {
        display: block;
        letter-spacing: -0.005em;
      }

      .signal-category {
        display: inline-block;
        margin-top: 4px;
        padding: 3px 7px;
        border-radius: 999px;
        background: var(--green-soft);
        color: var(--green-dark);
        font-size: 10px;
        font-weight: 800;
        letter-spacing: 0.015em;
      }

      .signal-detail { padding: 0 14px 15px 121px; }

      .signal-detail p { margin: 0 0 12px; }

      .implication {
        padding: 12px;
        border-left: 3px solid var(--green);
        border-radius: 8px;
        background: white;
      }

      .source-link {
        display: inline-block;
        margin-top: 12px;
        color: var(--green-dark);
        font-size: 13px;
        font-weight: 800;
        text-decoration: none;
      }

      .source-link:hover { text-decoration: underline; }

      .score-layout {
        display: grid;
        grid-template-columns: 210px 1fr;
        gap: 16px;
      }

      .score-box {
        padding: 22px;
        border-top: 5px solid var(--green);
        border-radius: 16px;
        background: var(--dark);
        color: white;
      }

      .score-number {
        color: var(--green);
        font-size: 3.3rem;
        font-weight: 900;
        line-height: 1;
        letter-spacing: -0.02em;
      }

      .score-caption {
        margin-top: 6px;
        color: #cbd0c7;
        font-size: 13px;
      }

      .score-status {
        display: inline-block;
        margin-top: 14px;
        padding: 6px 9px;
        border-radius: 999px;
        background: var(--green);
        color: var(--dark);
        font-size: 12px;
        font-weight: 800;
      }

      .score-list {
        display: grid;
        gap: 8px;
      }

      .score-row {
        padding: 12px 14px;
        border: 1px solid var(--border);
        border-radius: 12px;
      }

      .score-row-top {
        display: flex;
        justify-content: space-between;
        gap: 12px;
      }

      .score-row-top strong { font-size: 0.92rem; }

      .score-value {
        color: var(--green-dark);
        font-weight: 800;
      }

      .score-reason {
        margin-top: 4px;
        color: var(--muted);
        font-size: 0.84rem;
      }

      .score-track {
        height: 5px;
        margin-top: 8px;
        overflow: hidden;
        border-radius: 999px;
        background: #ecefe8;
      }

      .score-fill {
        height: 100%;
        border-radius: inherit;
        background: var(--green);
      }

      .hypothesis-box {
        padding: 20px;
        border-left: 5px solid var(--green);
        border-radius: 14px;
        background: #f9fbf6;
      }

      .hypothesis-label {
        display: block;
        margin-bottom: 7px;
        color: var(--green-dark);
        font-size: 12px;
        font-weight: 900;
        text-transform: uppercase;
        letter-spacing: 0.06em;
      }

      .question-box {
        padding: 22px;
        border-radius: 14px;
        background: var(--dark);
        color: white;
      }

      .question-box small {
        color: var(--green);
        font-weight: 800;
        text-transform: uppercase;
        letter-spacing: 0.05em;
      }

      .question-box blockquote {
        margin: 10px 0 0;
        font-size: 1.15rem;
        font-weight: 700;
        line-height: 1.45;
      }

      .action-list {
        display: grid;
        gap: 8px;
        margin-top: 14px;
        padding: 0;
        list-style: none;
      }

      .action-list li {
        padding: 13px 14px;
        border: 1px solid var(--border);
        border-left: 4px solid var(--green);
        border-radius: 10px;
      }

      .strategy-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 12px;
      }

      .strategy-card {
        padding: 17px;
        border: 1px solid var(--border);
        border-radius: 13px;
        background: #fafbf9;
      }

      .strategy-card h3 {
        margin: 0 0 7px;
        font-size: 0.84rem;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        color: var(--green-dark);
      }

      .strategy-card p {
        margin: 0;
        font-size: 0.92rem;
      }

      .target-list {
        display: flex;
        flex-wrap: wrap;
        gap: 6px;
        margin-top: 9px;
      }

      .target-chip {
        padding: 5px 8px;
        border-radius: 999px;
        background: var(--green-soft);
        color: #384f05;
        font-size: 11px;
        font-weight: 750;
      }

      .message-box {
        grid-column: 1 / -1;
        padding: 20px;
        border-radius: 14px;
        background: var(--dark);
        color: white;
      }

      .message-box h3 {
        margin: 0 0 9px;
        color: var(--green);
        font-size: 0.8rem;
        text-transform: uppercase;
        letter-spacing: 0.05em;
      }

      .message-box p {
        margin: 0;
        font-size: 1rem;
      }

      .caution {
        grid-column: 1 / -1;
        padding: 14px;
        border-left: 4px solid var(--green);
        border-radius: 10px;
        background: var(--green-soft);
        font-size: 0.9rem;
      }

      footer {
        margin-top: 34px;
        padding-top: 18px;
        border-top: 1px solid var(--border);
        color: var(--muted);
        font-size: 12px;
      }

      @media (max-width: 760px) {
        main {
          width: min(100% - 20px, 1050px);
          padding-top: 14px;
        }

        .hero { padding: 24px 20px; }

        .hero-content { grid-template-columns: 1fr; }

        h1 {
          font-size: clamp(2.2rem, 12vw, 3.4rem);
          line-height: 1.04;
          letter-spacing: -0.015em;
        }

        .company-name {
          margin-top: 12px;
          font-size: clamp(1.2rem, 7vw, 1.7rem);
          line-height: 1.2;
          letter-spacing: 0.01em;
        }

        .logo-wrap {
          width: 110px;
          height: 110px;
        }

        .decision-strip { grid-template-columns: repeat(2, 1fr); }

        .module-summary {
          grid-template-columns: 40px 1fr auto;
          padding: 15px;
        }

        .module-content { padding: 0 15px 18px; }

        .pressure-grid,
        .score-layout,
        .strategy-grid {
          grid-template-columns: 1fr;
        }

        .message-box,
        .caution {
          grid-column: auto;
        }

        .signal-summary {
          grid-template-columns: 1fr auto;
        }

        .signal-date { grid-column: 1 / 2; }

        .signal-title-wrap { grid-column: 1 / 2; }

        .signal-summary .chevron {
          grid-column: 2;
          grid-row: 1 / 3;
        }

        .signal-detail { padding: 0 14px 15px; }
      }
    </style>
  </head>

  <body>
    <main>
      <nav class="switcher" aria-label="Company switcher">
        <a href="/bardin">Overview</a>
        {
          companies.map((item) => (
            <a
              href={`/bardin/${item.slug}`}
              class={item.slug === company.slug ? "active" : ""}
              aria-current={item.slug === company.slug ? "page" : undefined}
            >
              {item.shortName}
            </a>
          ))
        }
      </nav>

      <header class="hero">
        <div class="hero-content">
          <div class="hero-text">
            <span class="eyebrow">Private GTM Experiment</span>

            <h1>
              Bardin × Germany
              <span class="company-name">{company.name}</span>
            </h1>

            <p class="hero-copy">
              Can public market signals identify companies where deployment
              complexity, technical knowledge bottlenecks, and engineering
              escalation create a strong opportunity for Bardin?
            </p>

            <div class="meta-row">
              <span class="meta-pill">{company.location}</span>
              <span class="meta-pill">{company.companyType}</span>
              <span class="meta-pill">Reviewed {company.reviewed}</span>
            </div>
          </div>

          <a
            href={company.homepage}
            target="_blank"
            rel="noopener noreferrer"
            class="logo-link"
            aria-label={`Visit ${company.name} website`}
          >
            <div class="logo-wrap">
              {
                company.logo ? (
                  <img
                    src={company.logo}
                    alt={`${company.name} logo`}
                    class="company-logo"
                  />
                ) : (
                  <div class="logo-placeholder" aria-label={`${company.name} logo placeholder`}>
                    {company.logoPlaceholder}
                  </div>
                )
              }
            </div>
          </a>
        </div>
      </header>

      <section class="decision-strip" aria-label="Account summary">
        <div class="decision-item">
          <span class="decision-label">ICP fit</span>
          <strong class="decision-value green">{company.totalScore}/100</strong>
        </div>

        <div class="decision-item">
          <span class="decision-label">Growth</span>
          <strong class="decision-value">{company.growth}</strong>
        </div>

        <div class="decision-item">
          <span class="decision-label">Complexity</span>
          <strong class="decision-value">{company.complexity}</strong>
        </div>

        <div class="decision-item">
          <span class="decision-label">GTM urgency</span>
          <strong class="decision-value">{company.urgency}</strong>
        </div>
      </section>

      <section class="main-insight">
        <strong>Why this account stands out</strong>
        <p>{company.mainInsight}</p>
      </section>

      <nav class="quick-nav" aria-label="Explore account">
        <button type="button" data-open="why-now">Why now?</button>
        <button type="button" data-open="signals">Signals</button>
        <button type="button" data-open="fit">ICP fit</button>
        <button type="button" data-open="hypothesis">Hypothesis</button>
        <button type="button" data-open="action">Action</button>
        <button type="button" data-open="outreach">GTM outreach</button>
      </nav>

      <section class="modules">
        <details class="module" id="why-now">
          <summary class="module-summary">
            <span class="module-number">01</span>
            <span class="module-title">
              <strong>Why is {company.shortName} interesting now?</strong>
              <span>Pressure, complexity, and timing</span>
            </span>
            <span class="chevron">+</span>
          </summary>

          <div class="module-content">
            <div class="pressure-grid">
              {
                company.pressure.map((item) => (
                  <div class="pressure-card">
                    <span>{item.label}</span>
                    <strong>{item.value}</strong>
                    <p>{item.text}</p>
                  </div>
                ))
              }
            </div>
          </div>
        </details>

        <details class="module" id="signals">
          <summary class="module-summary">
            <span class="module-number">02</span>
            <span class="module-title">
              <strong>What signals did the research find?</strong>
              <span>{company.signals.length} recent public signals</span>
            </span>
            <span class="chevron">+</span>
          </summary>

          <div class="module-content">
            <div class="signals-list">
              {
                company.signals.map((signal) => (
                  <details class="signal">
                    <summary class="signal-summary">
                      <span class="signal-date">{signal.date}</span>

                      <span class="signal-title-wrap">
                        <strong>{signal.title}</strong>
                        <span class="signal-category">{signal.category}</span>
                      </span>

                      <span class="chevron">+</span>
                    </summary>

                    <div class="signal-detail">
                      <p>{signal.summary}</p>

                      <div class="implication">
                        <strong>Possible GTM implication</strong><br />
                        {signal.why}
                      </div>

                      <a
                        class="source-link"
                        href={signal.source}
                        target="_blank"
                        rel="noopener noreferrer"
                      >
                        View original source ↗
                      </a>
                    </div>
                  </details>
                ))
              }
            </div>
          </div>
        </details>

        <details class="module" id="fit">
          <summary class="module-summary">
            <span class="module-number">03</span>
            <span class="module-title">
              <strong>Why does {company.shortName} fit Bardin's ICP?</strong>
              <span>{company.totalScore}/100 research score</span>
            </span>
            <span class="chevron">+</span>
          </summary>

          <div class="module-content">
            <div class="score-layout">
              <div class="score-box">
                <div class="score-number">{company.totalScore}</div>
                <div class="score-caption">out of 100</div>
                <span class="score-status">Strong potential fit</span>
              </div>

              <div class="score-list">
                {
                  company.scoreBreakdown.map((item) => (
                    <div class="score-row">
                      <div class="score-row-top">
                        <strong>{item.label}</strong>
                        <span class="score-value">{item.score}/{item.max}</span>
                      </div>
                      <div class="score-reason">{item.reason}</div>
                      <div class="score-track" aria-hidden="true">
                        <div
                          class="score-fill"
                          style={`width:${(item.score / item.max) * 100}%`}
                        />
                      </div>
                    </div>
                  ))
                }
              </div>
            </div>

            <p style="margin-top:14px;color:var(--muted);font-size:0.84rem;">
              This is a research heuristic, not a probability that the company
              will buy Bardin or that a specific internal bottleneck is confirmed.
            </p>
          </div>
        </details>

        <details class="module" id="hypothesis">
          <summary class="module-summary">
            <span class="module-number">04</span>
            <span class="module-title">
              <strong>What pain might exist?</strong>
              <span>Research-generated hypothesis to validate</span>
            </span>
            <span class="chevron">+</span>
          </summary>

          <div class="module-content">
            <div class="hypothesis-box">
              <span class="hypothesis-label">Hypothesis — not confirmed fact</span>
              {company.hypothesis}
            </div>
          </div>
        </details>

        <details class="module" id="action">
          <summary class="module-summary">
            <span class="module-number">05</span>
            <span class="module-title">
              <strong>What should Bardin do next?</strong>
              <span>Validate before selling</span>
            </span>
            <span class="chevron">+</span>
          </summary>

          <div class="module-content">
            <div class="question-box">
              <small>Best discovery question</small>
              <blockquote>“{company.discoveryQuestion}”</blockquote>
            </div>

            <ul class="action-list">
              {
                company.actions.map((action, index) => (
                  <li>
                    <strong>{index + 1}. {action.title}</strong><br />
                    {action.text}
                  </li>
                ))
              }
            </ul>
          </div>
        </details>

        <details class="module" id="outreach">
          <summary class="module-summary">
            <span class="module-number">06</span>
            <span class="module-title">
              <strong>Sample GTM outreach strategy</strong>
              <span>Angle, target roles, first touch, and pilot</span>
            </span>
            <span class="chevron">+</span>
          </summary>

          <div class="module-content">
            <div class="strategy-grid">
              <div class="strategy-card">
                <h3>Positioning angle</h3>
                <p>{company.outreach.angle}</p>
              </div>

              <div class="strategy-card">
                <h3>Target roles</h3>
                <div class="target-list">
                  {
                    company.outreach.targets.map((target) => (
                      <span class="target-chip">{target}</span>
                    ))
                  }
                </div>
              </div>

              <div class="message-box">
                <h3>Sample first-touch hypothesis</h3>
                <p>“{company.outreach.firstTouch}”</p>
              </div>

              <div class="strategy-card">
                <h3>Suggested pilot</h3>
                <p>{company.outreach.pilot}</p>
              </div>

              <div class="caution">
                <strong>Position carefully:</strong> {company.outreach.caution}
              </div>
            </div>
          </div>
        </details>
      </section>

      <footer>
        AI-assisted research · Human reviewed · Public sources linked · Research
        scores and pain hypotheses are intended for prioritization and validation,
        not presented as confirmed internal facts.
      </footer>
    </main>

    <script>
      const buttons = document.querySelectorAll("[data-open]");

      buttons.forEach((button) => {
        button.addEventListener("click", () => {
          const id = button.getAttribute("data-open");
          const target = document.getElementById(id);

          if (!target) return;

          target.open = true;
          target.scrollIntoView({
            behavior: "smooth",
            block: "start",
          });
        });
      });
    </script>
  </body>
</html>
