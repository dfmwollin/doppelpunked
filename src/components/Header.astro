---
const currentPath = Astro.url.pathname;
const links = [
  { href: "/", label: "Start" },
  { href: "/about", label: "Über mich" },
  { href: "/services", label: "Angebot" },
  { href: "/projects", label: "Projekte" },
  { href: "/resources", label: "Ressourcen" },
  { href: "/contact", label: "Kontakt" },
];
---
<header class="site-header">
  <div class="header-inner">
    <a class="logo" href="/">:Doppelpunked</a>

    <nav aria-label="Hauptnavigation">
      {links.map((link) => (
        <a class:list={[{ active: currentPath === link.href }]} href={link.href}>
          {link.label}
        </a>
      ))}
    </nav>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 20;
    border-bottom: 1px solid rgba(217,224,231,.9);
    background: rgba(245,246,247,.9);
    backdrop-filter: blur(14px);
  }

  .header-inner {
    width: min(1120px, calc(100% - 40px));
    min-height: 76px;
    margin-inline: auto;
    display: flex;
    align-items: center;
    gap: 28px;
  }

  .logo {
    margin-right: auto;
    font-size: 1.3rem;
    font-weight: 800;
    letter-spacing: -.035em;
    text-decoration: none;
  }

  nav {
    display: flex;
    flex-wrap: wrap;
    gap: 20px;
  }

  nav a {
    color: #536579;
    font-size: .93rem;
    font-weight: 650;
    text-decoration: none;
  }

  nav a:hover,
  nav a.active {
    color: #174f82;
  }

  @media (max-width: 850px) {
    nav { display: none; }
  }

  @media (max-width: 600px) {
    .header-inner {
      width: min(100% - 28px, 1120px);
      min-height: 66px;
    }
    .logo { font-size: 1.08rem; }
  }
</style>
