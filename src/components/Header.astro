---
const currentPath = Astro.url.pathname;

const links = [
  { href: "/", de: "Start", en: "Home" },
  { href: "/about", de: "Über mich", en: "About" },
  { href: "/services", de: "Angebot", en: "Services" },
  { href: "/projects", de: "Projekte", en: "Projects" },
  { href: "/resources", de: "Ressourcen", en: "Resources" },
  { href: "/contact", de: "Kontakt", en: "Contact" },
];
---

<header class="site-header">
  <div class="header-inner">
    <a
      class="logo"
      href="/"
      aria-label="Doppelpunked Startseite"
    >
      :Doppelpunked
    </a>

    <nav class="desktop-nav" aria-label="Hauptnavigation">
      {
        links.map((link) => (
          <a
            class:list={{
              active:
                currentPath === link.href ||
                (link.href !== "/" &&
                  currentPath.startsWith(link.href)),
            }}
            href={link.href}
            data-de={link.de}
            data-en={link.en}
          >
            {link.de}
          </a>
        ))
      }
    </nav>

    <div
      class="language-switch"
      aria-label="Sprache auswählen"
    >
      <button
        class="language-button active"
        type="button"
        data-language="de"
        aria-pressed="true"
      >
        DE
      </button>

      <button
        class="language-button"
        type="button"
        data-language="en"
        aria-pressed="false"
      >
        EN
      </button>
    </div>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    border-bottom: 1px solid rgba(217, 224, 231, 0.9);
    background: rgba(245, 246, 247, 0.9);
    backdrop-filter: blur(16px);
  }

  .header-inner {
    width: min(1120px, calc(100% - 40px));
    min-height: 76px;
    margin-inline: auto;
    display: flex;
    align-items: center;
    gap: 28px;
  }

  .logo {
    flex-shrink: 0;
    margin-right: auto;
    color: #10243d;
    font-size: 1.28rem;
    font-weight: 800;
    letter-spacing: -0.04em;
    text-decoration: none;
  }

  .logo:hover {
    color: #174f82;
  }

  .desktop-nav {
    display: flex;
    align-items: center;
    gap: 24px;
  }

  .desktop-nav a {
    position: relative;
    padding-block: 8px;
    color: #536579;
    font-size: 0.94rem;
    font-weight: 650;
    text-decoration: none;
    transition: color 180ms ease;
  }

  .desktop-nav a::after {
    content: "";
    position: absolute;
    right: 0;
    bottom: 2px;
    left: 0;
    height: 2px;
    border-radius: 999px;
    background: linear-gradient(
      90deg,
      #174f82,
      #6c4aa3
    );
    transform: scaleX(0);
    transform-origin: right;
    transition: transform 180ms ease;
  }

  .desktop-nav a:hover,
  .desktop-nav a.active {
    color: #174f82;
  }

  .desktop-nav a:hover::after,
  .desktop-nav a.active::after {
    transform: scaleX(1);
    transform-origin: left;
  }

  .language-switch {
    display: inline-flex;
    flex-shrink: 0;
    gap: 3px;
    padding: 3px;
    border: 1px solid #cbd5df;
    border-radius: 10px;
    background: rgba(255, 255, 255, 0.9);
    box-shadow: 0 3px 12px rgba(16, 36, 61, 0.05);
  }

  .language-button {
    min-width: 42px;
    min-height: 36px;
    padding: 7px 10px;
    border: 0;
    border-radius: 7px;
    background: transparent;
    color: #536579;
    cursor: pointer;
    font-family: inherit;
    font-size: 0.84rem;
    font-weight: 750;
    line-height: 1;
    transition:
      background 160ms ease,
      color 160ms ease,
      transform 160ms ease;
  }

  .language-button:hover {
    color: #174f82;
    background: #edf3f8;
  }

  .language-button.active {
    background: #174f82;
    color: white;
    box-shadow: 0 4px 10px rgba(23, 79, 130, 0.2);
  }

  .language-button:active {
    transform: translateY(1px);
  }

  @media (max-width: 950px) {
    .desktop-nav {
      gap: 15px;
    }

    .desktop-nav a {
      font-size: 0.86rem;
    }

    .header-inner {
      gap: 18px;
    }
  }

  @media (max-width: 790px) {
    .desktop-nav {
      display: none;
    }

    .header-inner {
      min-height: 68px;
    }
  }

  @media (max-width: 600px) {
    .header-inner {
      width: min(100% - 28px, 1120px);
      gap: 12px;
    }

    .logo {
      font-size: 1.08rem;
    }

    .language-button {
      min-width: 36px;
      min-height: 34px;
      padding: 7px 8px;
    }
  }
</style>