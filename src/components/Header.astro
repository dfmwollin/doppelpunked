---
const currentPath = Astro.url.pathname;

const links = [
  { href: "/", de: "Start", en: "Home" },
  { href: "/about", de: "Über mich", en: "About" },
  { href: "/services", de: "Angebot", en: "Services" },
  { href: "/projects", de: "Projekte", en: "Projects" },
  { href: "/resources", de: "Ressourcen", en: "Resources" },
  { href: "/contact", de: "Kontakt", en: "Contact" },
];
---

<header class="site-header">
  <div class="header-inner">
    <a
      class="logo"
      href="/"
      aria-label="Doppelpunked Startseite"
    >
      :Doppelpunked
    </a>

    <nav
      id="main-navigation"
      class="main-navigation"
      aria-label="Hauptnavigation"
    >
      {
        links.map((link) => (
          <a
            class:list={{
              active:
                currentPath === link.href ||
                (
                  link.href !== "/" &&
                  currentPath.startsWith(link.href)
                ),
            }}
            href={link.href}
            data-de={link.de}
            data-en={link.en}
          >
            {link.de}
          </a>
        ))
      }
    </nav>

    <div
      class="language-switch"
      aria-label="Sprache auswählen"
    >
      <button
        class="language-button active"
        type="button"
        data-language="de"
        aria-pressed="true"
      >
        DE
      </button>

      <button
        class="language-button"
        type="button"
        data-language="en"
        aria-pressed="false"
      >
        EN
      </button>
    </div>

    <button
      id="menu-button"
      class="menu-button"
      type="button"
      aria-expanded="false"
      aria-controls="main-navigation"
      aria-label="Menü öffnen"
    >
      <span></span>
      <span></span>
      <span></span>
    </button>
  </div>
</header>

<script is:inline>
  const menuButton =
    document.querySelector("#menu-button");

  const mainNavigation =
    document.querySelector("#main-navigation");

  if (menuButton && mainNavigation) {
    menuButton.addEventListener("click", () => {
      const isOpen =
        mainNavigation.classList.toggle("is-open");

      menuButton.classList.toggle("is-open", isOpen);

      menuButton.setAttribute(
        "aria-expanded",
        String(isOpen)
      );
    });

    mainNavigation
      .querySelectorAll("a")
      .forEach((link) => {
        link.addEventListener("click", () => {
          mainNavigation.classList.remove("is-open");
          menuButton.classList.remove("is-open");

          menuButton.setAttribute(
            "aria-expanded",
            "false"
          );
        });
      });
  }
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    border-bottom: 1px solid #d9e0e7;
    background: rgba(245, 246, 247, 0.94);
    backdrop-filter: blur(16px);
  }

  .header-inner {
    position: relative;
    width: min(1120px, calc(100% - 40px));
    min-height: 76px;
    margin-inline: auto;
    display: flex;
    align-items: center;
    gap: 24px;
  }

  .logo {
    flex-shrink: 0;
    margin-right: auto;
    color: #10243d;
    font-size: 1.28rem;
    font-weight: 800;
    letter-spacing: -0.04em;
    text-decoration: none;
  }

  .logo:hover {
    color: #174f82;
  }

  .main-navigation {
    display: flex;
    align-items: center;
    gap: 22px;
  }

  .main-navigation a {
    position: relative;
    display: inline-block;
    padding-block: 8px;
    color: #536579;
    font-size: 0.92rem;
    font-weight: 650;
    line-height: 1.2;
    text-decoration: none;
    white-space: nowrap;
    transition: color 180ms ease;
  }

  .main-navigation a::after {
    content: "";
    position: absolute;
    right: 0;
    bottom: 1px;
    left: 0;
    height: 2px;
    border-radius: 999px;
    background: linear-gradient(
      90deg,
      #174f82,
      #6c4aa3
    );
    transform: scaleX(0);
    transform-origin: right;
    transition: transform 180ms ease;
  }

  .main-navigation a:hover,
  .main-navigation a.active {
    color: #174f82;
  }

  .main-navigation a:hover::after,
  .main-navigation a.active::after {
    transform: scaleX(1);
    transform-origin: left;
  }

  .language-switch {
    display: inline-flex;
    flex-shrink: 0;
    gap: 3px;
    padding: 3px;
    border: 1px solid #cbd5df;
    border-radius: 10px;
    background: white;
    box-shadow: 0 4px 14px rgba(16, 36, 61, 0.06);
  }

  .language-button {
    min-width: 42px;
    min-height: 36px;
    padding: 7px 10px;
    border: 0;
    border-radius: 7px;
    background: transparent;
    color: #536579;
    cursor: pointer;
    font-family: inherit;
    font-size: 0.84rem;
    font-weight: 750;
    line-height: 1;
    transition:
      background 160ms ease,
      color 160ms ease,
      box-shadow 160ms ease;
  }

  .language-button:hover {
    background: #edf3f8;
    color: #174f82;
  }

  .language-button.active {
    background: #174f82;
    color: white;
    box-shadow: 0 4px 10px rgba(23, 79, 130, 0.2);
  }

  .menu-button {
    display: none;
    width: 42px;
    height: 40px;
    flex-shrink: 0;
    padding: 8px 9px;
    border: 1px solid #cbd5df;
    border-radius: 9px;
    background: white;
    cursor: pointer;
  }

  .menu-button span {
    display: block;
    width: 100%;
    height: 2px;
    margin-block: 4px;
    border-radius: 999px;
    background: #174f82;
    transition:
      transform 180ms ease,
      opacity 180ms ease;
  }

  .menu-button.is-open span:nth-child(1) {
    transform: translateY(6px) rotate(45deg);
  }

  .menu-button.is-open span:nth-child(2) {
    opacity: 0;
  }

  .menu-button.is-open span:nth-child(3) {
    transform: translateY(-6px) rotate(-45deg);
  }

  @media (max-width: 1000px) {
    .header-inner {
      gap: 16px;
    }

    .main-navigation {
      gap: 14px;
    }

    .main-navigation a {
      font-size: 0.84rem;
    }
  }

  @media (max-width: 840px) {
    .menu-button {
      display: block;
    }

    .main-navigation {
      position: absolute;
      top: calc(100% + 10px);
      right: 0;
      left: 0;
      display: none;
      padding: 12px;
      border: 1px solid #d9e0e7;
      border-radius: 14px;
      background: rgba(255, 255, 255, 0.99);
      box-shadow: 0 20px 50px rgba(16, 36, 61, 0.16);
    }

    .main-navigation.is-open {
      display: grid;
      gap: 4px;
    }

    .main-navigation a {
      display: block;
      padding: 12px 14px;
      border-radius: 8px;
      font-size: 1rem;
    }

    .main-navigation a:hover,
    .main-navigation a.active {
      background: #edf3f8;
    }

    .main-navigation a::after {
      display: none;
    }
  }

  @media (max-width: 600px) {
    .header-inner {
      width: min(100% - 28px, 1120px);
      min-height: 68px;
      gap: 9px;
    }

    .logo {
      font-size: 1.05rem;
    }

    .language-button {
      min-width: 34px;
      min-height: 34px;
      padding: 6px;
      font-size: 0.78rem;
    }

    .menu-button {
      width: 38px;
      height: 36px;
      padding: 6px 8px;
    }
  }

  @media (max-width: 390px) {
    .logo {
      font-size: 0.95rem;
    }

    .language-button {
      min-width: 30px;
    }
  }
</style>